<UserControl x:Class="Gui.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <Storyboard x:Key="Help.Open">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Answer"
                                           Storyboard.TargetProperty="(views:RevealDecorator.Reveal)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="1" KeySpline="0.32,0.72 0,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="0" KeySpline="0.32,0.72 0,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="Help.Close">
            <DoubleAnimation Storyboard.TargetName="Answer"
                             Storyboard.TargetProperty="(views:RevealDecorator.Reveal)"
                             To="0" Duration="0:0:0" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Chevron"
                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                <SplineDoubleKeyFrame KeyTime="0:0:0.2" Value="-90" KeySpline="0.32,0.72 0,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style x:Key="Help.Text" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>
        <Style x:Key="Help.Heading" TargetType="TextBlock" BasedOn="{StaticResource Help.Text}">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="Help.QuestionTitle" TargetType="TextBlock" BasedOn="{StaticResource Help.Heading}">
            <Setter Property="LineHeight" Value="20" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                             Value="True">
                    <Setter Property="TextDecorations">
                        <Setter.Value>
                            <TextDecorationCollection>
                                <TextDecoration Location="Underline" PenOffset="2" PenOffsetUnit="Pixel"
                                                PenThicknessUnit="Pixel">
                                    <TextDecoration.Pen>
                                        <Pen Brush="{DynamicResource Brush.Border.Subtle}" Thickness="1" />
                                    </TextDecoration.Pen>
                                </TextDecoration>
                            </TextDecorationCollection>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Help.Chip" TargetType="Border">
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Brush.Help.InlineFill}" />
        </Style>
        <Style x:Key="Help.ChipText" TargetType="TextBlock" BasedOn="{StaticResource Help.Text}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="Help.Key" TargetType="Border">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style x:Key="Help.KeyText" TargetType="TextBlock" BasedOn="{StaticResource Help.ChipText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Help.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Help.Card}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <DataTemplate DataType="{x:Type views:HelpParagraph}">
            <TextBlock Margin="0,0,0,12" Style="{StaticResource Help.Text}" views:HelpMarkup.Text="{Binding Text}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type views:HelpChoice}">
            <ItemsControl Margin="-4,0,-4,16" ItemsSource="{Binding Options}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,0" Style="{StaticResource Help.Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Help.Heading}" />
                                <TextBlock Style="{StaticResource Help.Text}" views:HelpMarkup.Text="{Binding Text}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <Style x:Key="Help.StepGap" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter Property="Margin" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type views:HelpSteps}">
            <StackPanel>
                <TextBlock x:Name="StepsTitle" Margin="0,0,0,8" Style="{StaticResource Help.Text}"
                           Foreground="{DynamicResource Brush.Text.Primary}" views:HelpMarkup.Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Items}" AlternationCount="2147483647"
                              ItemContainerStyle="{StaticResource Help.StepGap}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Border Width="20" Height="20" Margin="0,3,0,0" CornerRadius="10"
                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Background="{DynamicResource Brush.Help.InlineFill}">
                                    <TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" />
                                </Border>
                                <TextBlock Margin="30,0,0,0" Style="{StaticResource Help.Text}"
                                           views:HelpMarkup.Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                    <Setter TargetName="StepsTitle" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type views:HelpTip}">
            <Border Margin="0,16,0,0" Style="{StaticResource Help.Card}">
                <DockPanel>
                    <Viewbox Width="14" Height="14" Margin="0,4,10,0" VerticalAlignment="Top">
                        <Canvas Width="16" Height="16">
                            <Path Data="M6,12 H10 M6.5,14 H9.5 M8,2.5 A4,4 0 0 0 5.6,9.7
                                        C6.1,10.1 6.5,10.7 6.5,11.3 V12 H9.5 V11.3
                                        C9.5,10.7 9.9,10.1 10.4,9.7 A4,4 0 0 0 8,2.5"
                                  Stroke="{DynamicResource Brush.Text.Muted}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Style="{StaticResource Help.Text}" Foreground="{DynamicResource Brush.Text.Primary}"
                               views:HelpMarkup.Text="{Binding Text}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="Help.QuestionHeader" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Padding" Value="4,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="Help.Question" DataType="{x:Type views:HelpQuestion}">
            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <ToggleButton Style="{StaticResource Help.QuestionHeader}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Title}">
                        <DockPanel>
                            <Viewbox x:Name="Chevron" DockPanel.Dock="Right" Width="14" Height="14"
                                     Margin="16,2,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform>
                                    <RotateTransform Angle="-90" />
                                </Viewbox.RenderTransform>
                                <Canvas Width="16" Height="16">
                                    <Path x:Name="ChevronStroke" Data="M4.5,6.5 L8,10 11.5,6.5"
                                          Stroke="{DynamicResource Brush.Text.Muted}" StrokeThickness="1.3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Help.QuestionTitle}" />
                                <TextBlock x:Name="Summary" Margin="0,2,0,0" FontSize="13" LineHeight="19"
                                           Style="{StaticResource Help.Text}" views:HelpMarkup.Text="{Binding Summary}" />
                            </StackPanel>
                        </DockPanel>
                    </ToggleButton>
                    <views:RevealDecorator x:Name="Answer">
                        <ItemsControl Padding="4,0,4,20" ItemsSource="{Binding Blocks}" Focusable="False" />
                    </views:RevealDecorator>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="ChevronStroke" Property="Stroke" Value="{DynamicResource Brush.Text.Primary}" />
                    <Setter TargetName="Summary" Property="Visibility" Value="Collapsed" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Storyboard="{StaticResource Help.Open}" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard Storyboard="{StaticResource Help.Close}" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource Brush.Canvas}" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,40,48,80" MaxWidth="720">
            <TextBlock Text="常见问题" FontSize="24" LineHeight="32" Style="{StaticResource Help.Heading}"
                       AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="遇到问题时先在这里自查，大多数情况按步骤操作即可解决。" Margin="0,6,0,0"
                       LineHeight="20" Style="{StaticResource Help.Text}" />
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,32,0,0">
                            <TextBlock Text="{Binding Title}" Margin="0,0,0,8" FontSize="13" LineHeight="18"
                                       Foreground="{DynamicResource Brush.Text.Muted}" Style="{StaticResource Help.Heading}"
                                       AutomationProperties.HeadingLevel="Level2" />
                            <ItemsControl ItemsSource="{Binding Questions}" ItemTemplate="{StaticResource Help.Question}"
                                          Focusable="False" />
                            <Border Height="1" Background="{DynamicResource Brush.Border.Subtle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

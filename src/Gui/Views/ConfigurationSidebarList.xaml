<UserControl x:Class="Gui.Views.ConfigurationSidebarList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <Grid Background="{DynamicResource Brush.Transparent}" AllowDrop="True"
          DragOver="List_DragOver" DragLeave="List_DragLeave" Drop="List_Drop">
        <ScrollViewer x:Name="ConfigurationScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False"
                      AutomationProperties.Name="任务配置">
            <StackPanel x:Name="Rows" KeyboardNavigation.TabNavigation="Once" />
        </ScrollViewer>
        <views:ListReorderFeedback x:Name="DragFeedback" />
    </Grid>
</UserControl>

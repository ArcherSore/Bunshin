<UserControl x:Class="Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views"
             xmlns:settings="clr-namespace:Gui.Settings"
             xmlns:protocol="clr-namespace:Protocol;assembly=Protocol">
    <UserControl.Resources>
        <Style x:Key="SettingsCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TaskIconButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsPressed" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Active}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionNavigationItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Definition.Title}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SelectedSection_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Active}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OptionalText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19.5" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <Trigger Property="Text" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ItemHeading" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="LineHeight" Value="20" />
        </Style>
        <Style x:Key="ItemDescription" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>
        <Style x:Key="ItemButton" TargetType="Button" BasedOn="{StaticResource PressScaleButtonStyle}">
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Settings.Action}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="14"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Settings.ActionHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ChoiceName">
            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
        </DataTemplate>
        <Style x:Key="ItemChoice" TargetType="ComboBox" BasedOn="{StaticResource ChoiceBoxStyle}">
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="Width" Value="180" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Settings.Field}" />
            <Setter Property="ItemTemplate" Value="{StaticResource ChoiceName}" />
            <Setter Property="TextSearch.TextPath" Value="Name" />
        </Style>
        <Style x:Key="ItemToggle" TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="24,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Settings.SwitchTrack}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:ToggleSwitch">
                        <Border x:Name="Track" Style="{StaticResource SwitchTrackStyle}">
                            <Ellipse x:Name="Thumb" Style="{StaticResource SwitchKnobStyle}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ToggleRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                    <TextBlock Text="{Binding Toggle.Status}" Style="{StaticResource OptionalText}"
                               Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1" Style="{StaticResource ItemToggle}"
                                 OnContent="{x:Null}" OffContent="{x:Null}"
                                 IsChecked="{Binding Toggle.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding Toggle.IsEnabled}"
                                 AutomationProperties.AutomationId="{Binding Definition.Id}"
                                 AutomationProperties.Name="{Binding Definition.Title}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                    <TextBlock Text="{Binding Choice.Status}" Style="{StaticResource OptionalText}"
                               Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource ItemChoice}"
                          ItemsSource="{Binding Choice.Options}"
                          SelectedItem="{Binding Choice.Selected, Mode=TwoWay}"
                          AutomationProperties.AutomationId="{Binding Definition.Id}"
                          AutomationProperties.Name="{Binding Definition.Title}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                    <TextBlock Text="{Binding Action.Status}" Margin="0,4,0,0"
                               AutomationProperties.LiveSetting="Polite" Style="{StaticResource OptionalText}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Definition.ButtonText}" Command="{Binding Action}"
                        Style="{StaticResource ItemButton}"
                        AutomationProperties.AutomationId="{Binding Definition.Id}"
                        AutomationProperties.Name="{Binding Definition.Title}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="InfoRow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Definition.Title}" Style="{StaticResource ItemHeading}" />
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource ItemDescription}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Value.Text}" Margin="24,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}"
                           FontSize="14" Style="{StaticResource OptionalText}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AboutRow">
            <StackPanel>
                <StackPanel Margin="0,16,0,8" HorizontalAlignment="Center">
                    <Image x:Name="ProjectAboutIcon" Width="72" Height="72"
                           Source="{Binding About.Icon, TargetNullValue='pack://application:,,,/Assets/app.png'}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="ProjectAboutName"
                               Text="{Binding About.Content.Name, TargetNullValue={x:Static protocol:AppIdentity.Name},
                                              FallbackValue={x:Static protocol:AppIdentity.Name}}"
                               Margin="0,14,0,0" FontSize="26" FontFamily="{StaticResource FontFamily.Wordmark}"
                               Foreground="{DynamicResource Brush.Text.Primary}" TextAlignment="Center" />
                    <TextBlock Text="{Binding Value.Text, StringFormat='版本 {0}'}"
                               Margin="0,4,0,0" Foreground="{DynamicResource Brush.Text.Muted}" TextAlignment="Center" />
                </StackPanel>
                <views:ProjectAboutView Project="{Binding About.Content}" OpenLink="{Binding About.OpenLink}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SettingRow" TargetType="ContentControl">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Toggle}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ToggleRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Choice}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ChoiceRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Action}">
                    <Setter Property="ContentTemplate" Value="{StaticResource ActionRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.Info}">
                    <Setter Property="ContentTemplate" Value="{StaticResource InfoRow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}"
                             Value="{x:Static settings:SettingsItemKind.About}">
                    <Setter Property="ContentTemplate" Value="{StaticResource AboutRow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Padding" Value="0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Style.Triggers>
                <DataTrigger Value="0" Binding="{Binding (ItemsControl.AlternationIndex),
                    RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Definition.Type}" Value="{x:Static settings:SettingsItemKind.About}">
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Action.IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <views:ShadowBorder Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Dialog.Border}" BorderThickness="1"
                        CornerRadius="14" Shadow="{DynamicResource Effect.Dialog.Welcome}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                <DockPanel Margin="16,0,8,0">
                    <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                            Style="{StaticResource SettingsCloseButtonStyle}" Click="CloseSettings_Click"
                            AutomationProperties.Name="关闭设置">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="18"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <TextBlock Text="设置" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </DockPanel>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                        BorderThickness="0,0,1,0" CornerRadius="0,0,0,13" Padding="10,14,10,12">
                    <ListBox x:Name="SectionNavigation" ItemsSource="{Binding Sections}" SelectedIndex="0"
                             Background="{DynamicResource Brush.Transparent}" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource SectionNavigationItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SettingsSection_SelectionChanged" AutomationProperties.Name="设置分类">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <ui:SymbolIcon Symbol="{Binding Definition.Icon}" FontSize="16" Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Definition.Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <ScrollViewer x:Name="SectionScroller" Grid.Column="1"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="SectionScroller_ScrollChanged">
                    <StackPanel Margin="24,0,24,32">
                        <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0,20,0,0" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Definition.Title}" FontSize="16" FontWeight="Medium"
                                                   LineHeight="24" LineStackingStrategy="BlockLineHeight"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Definition.Description}" Margin="0,4,0,0"
                                                   Style="{StaticResource ItemDescription}" />
                                        <ItemsControl ItemsSource="{Binding Cards}" AlternationCount="2147483647" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ItemsControl ItemsSource="{Binding}" AlternationCount="2147483647">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="Margin" Value="0,20,0,0" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="0" Binding="{Binding (ItemsControl.AlternationIndex),
                                                                                 RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                                                        <Setter Property="Margin" Value="0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource RowBorder}">
                                                                    <ContentControl Content="{Binding}" Style="{StaticResource SettingRow}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </views:ShadowBorder>
</UserControl>

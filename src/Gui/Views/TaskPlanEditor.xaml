<UserControl x:Class="Gui.Views.TaskPlanEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <views:ScrollEdgeVisibilityConverter x:Key="Scroll.EdgeVisibility" />
        <!-- Canvas scroll areas: overlay thin scrollbar in the right gutter, edges fade while more content exists. -->
        <ControlTemplate x:Key="Scroll.Faded" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                <Border x:Name="TopFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Background="{DynamicResource Brush.Scroll.FadeTop}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Top">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <Border x:Name="BottomFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        Background="{DynamicResource Brush.Scroll.FadeBottom}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Bottom">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Minimum="0"
                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay,
                               RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
        <!-- Parameter editors share one height. The implicit TextBlock style keeps disabled caption text dark,
             so a locked dropdown or switch fades as a whole; the text box has its own disabled colours. -->
        <Style x:Key="Option.TextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style x:Key="Option.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Option.ToggleSwitch" TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Checkbox cases as separate segments that wrap; checked ones fill with the primary colour. A case with a
             description shows it as a tooltip. -->
        <Style x:Key="Option.Segments" TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Multiple" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Margin" Value="0,3,6,3" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding Description}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subdued}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Hover}" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="TasksView" Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36">
            <TextBlock Text="任务" VerticalAlignment="Center" Style="{StaticResource WindowTitleTextStyle}" />
            <Border x:Name="ConfigurationLockBadge" HorizontalAlignment="Right" Padding="8,3,10,3"
                    VerticalAlignment="Center" CornerRadius="11" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Surface.Disabled}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="LockClosed16" FontSize="14" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock x:Name="ConfigurationLockText" VerticalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="ProjectValidationBorder"
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource Brush.Error.Surface}"
                BorderBrush="{DynamicResource Brush.Error.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}"
                Visibility="Collapsed">
            <TextBlock x:Name="ProjectValidationText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Error.Foreground}"
                       Style="{StaticResource SecondaryTextStyle}"
                       AutomationProperties.Name="任务配置校验结果"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border x:Name="ProjectEmptyStatePanel"
                Grid.Row="2"
                Margin="0,16,0,0"
                Style="{StaticResource SettingsSectionPanelStyle}">
            <StackPanel MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ProjectEmptyStateTitleText"
                           HorizontalAlignment="Center"
                           Text="项目无法加载"
                           TextAlignment="Center"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock x:Name="ProjectEmptyStateDetailText"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Text="请使用完整发布包，确保安装目录下直接包含 interface.json。"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Border>

        <Grid x:Name="TaskWorkspacePanel"
              Grid.Row="2"
              Margin="0,12,0,0"
              SizeChanged="TaskWorkspacePanel_SizeChanged"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="142" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Height="34" Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="执行计划" FontSize="15"
                               Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock x:Name="PlanCountText" Margin="8,0,0,0" FontSize="13"
                               VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <!-- Opens the inline panel that stays open while several tasks are added. -->
                <Button x:Name="TaskShelfHeaderButton" Grid.Column="2" Height="32" Padding="12,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="TaskShelfHeaderButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="TaskShelfHeaderIcon" Symbol="Add16" FontSize="15"
                                       Margin="0,0,6,0" />
                        <TextBlock x:Name="TaskShelfHeaderText" Text="添加任务" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground,
                                       RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="TaskShelfContent" Visibility="Collapsed"
                    Grid.Row="1" MaxHeight="340" Margin="0,10,8,0"
                    Style="{StaticResource TaskShelfSurfaceStyle}" AutomationProperties.Name="添加任务">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="12,8,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="可用任务" VerticalAlignment="Center"
                                       Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock x:Name="AvailableTaskCountText" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}" />
                            <StackPanel x:Name="AddedTasksBadge" Orientation="Horizontal"
                                        Margin="12,0,0,0" Background="{DynamicResource Brush.Transparent}"
                                        Visibility="Collapsed">
                                <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Margin="0,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Tasks.Accent}" />
                                <TextBlock x:Name="AddedTasksText" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Success.Foreground}" />
                            </StackPanel>
                        </StackPanel>
                        <ui:TextBox x:Name="TaskSearchBox" Grid.Column="2" Width="180" MinHeight="32"
                                    PlaceholderText="搜索任务"
                                    AutomationProperties.Name="搜索可用任务"
                                    TextChanged="TaskSearchBox_TextChanged" />
                    </Grid>
                    <ScrollViewer x:Name="AvailableTasksScroll" Grid.Row="1" Margin="12,0,0,8"
                                  Template="{StaticResource Scroll.Faded}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel x:Name="AvailableTasksPanel" Margin="0,0,8,0" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <ScrollViewer x:Name="PlanScroll" Grid.Row="2" Margin="0,10,0,0" MinHeight="132"
                          Template="{StaticResource Scroll.Faded}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <StackPanel Margin="0,0,8,24">
                    <StackPanel x:Name="PlanItemsPanel"
                                AllowDrop="True"
                                DragLeave="PlanItemsPanel_DragLeave"
                                DragOver="PlanItemsPanel_DragOver"
                                Drop="PlanItemsPanel_Drop" />

                    <StackPanel x:Name="EmptyPlanPanel" Margin="0,16,0,0">
                        <TextBlock Text="执行计划为空" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyPlanText" Margin="0,4,0,0"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <Button x:Name="EmptyPlanAddButton" Margin="0,12,0,0" Height="32"
                                Padding="12,0" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="TaskShelfHeaderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add16" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="添加任务" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

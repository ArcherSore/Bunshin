<UserControl x:Class="Gui.Views.TaskPlanEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <views:ScrollEdgeVisibilityConverter x:Key="Scroll.EdgeVisibility" />
        <!-- Canvas scroll areas: overlay thin scrollbar in the right gutter, edges fade while more content exists. -->
        <ControlTemplate x:Key="Scroll.Faded" TargetType="ScrollViewer">
            <Grid>
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        CanContentScroll="{TemplateBinding CanContentScroll}" />
                <Border x:Name="TopFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Background="{DynamicResource Brush.Scroll.FadeTop}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Top">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <Border x:Name="BottomFade" Height="{StaticResource Height.ScrollFade}" VerticalAlignment="Bottom"
                        IsHitTestVisible="False"
                        Background="{DynamicResource Brush.Scroll.FadeBottom}">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource Scroll.EdgeVisibility}" ConverterParameter="Bottom">
                            <Binding Path="VerticalOffset" RelativeSource="{RelativeSource TemplatedParent}" />
                            <Binding Path="ScrollableHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                        </MultiBinding>
                    </Border.Visibility>
                </Border>
                <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Minimum="0"
                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                           Value="{Binding VerticalOffset, Mode=OneWay,
                               RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </ControlTemplate>
        <!-- Parameter editors share one height. The implicit TextBlock style keeps disabled caption text dark,
             so a locked dropdown or switch fades as a whole; the text box has its own disabled colours. -->
        <Style x:Key="Option.TextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style x:Key="Option.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,5,10,5" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Option.ToggleSwitch" TargetType="ui:ToggleSwitch"
               BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Checkbox cases as separate segments that wrap; checked ones fill with the primary colour. A case with a
             description shows it as a tooltip. -->
        <Style x:Key="Option.Segments" TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Multiple" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="30" />
                        <Setter Property="Margin" Value="0,3,6,3" />
                        <Setter Property="Padding" Value="12,0" />
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="ToolTip" Value="{Binding Description}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description}" Value="">
                                <Setter Property="ToolTip" Value="{x:Null}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Subdued}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Brush.Primary.Hover}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary.Hover}" />
                            </MultiTrigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Plan.HeaderAction" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Plan.Button}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Label" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Plan.Current}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Plan.Selection" TargetType="CheckBox">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource Brush.Canvas}"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Path x:Name="Check" Data="M 3.4,7.5 L 6.1,10 L 10.7,4.8"
                                  Stroke="{DynamicResource Brush.Plan.Check}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Plan.CatalogItem" TargetType="Button" BasedOn="{StaticResource PlanHeaderButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Plan.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Plan.CatalogAddedItem" TargetType="Button" BasedOn="{StaticResource Plan.CatalogItem}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="TasksView" Margin="32,32,32,0" MaxWidth="768">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="32" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock Text="执行计划" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock x:Name="PlanCountText" Margin="12,0,0,0" FontSize="14"
                           VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                <Border x:Name="ConfigurationLockBadge" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="LockClosed16" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Disabled}" />
                </Border>
            </StackPanel>
            <StackPanel x:Name="PlanActions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="StartPlanButton" Style="{StaticResource Plan.HeaderAction}" Margin="0,0,12,0"
                        ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="运行" Click="StartPlanButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 0,0 L 0,8 L 7,4 Z" Margin="0,0,7,0" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="运行" FontSize="14" Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="StopPlanButton" Style="{StaticResource Plan.HeaderAction}" Margin="0,0,12,0"
                        Visibility="Collapsed" AutomationProperties.Name="停止" Click="StopPlanButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="1" Margin="0,0,7,0"
                                Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="停止" FontSize="14" Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
                <Button x:Name="TaskShelfHeaderButton" Style="{StaticResource Plan.HeaderAction}"
                        Click="TaskShelfHeaderButton_Click" AutomationProperties.Name="添加任务">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add16" FontSize="16" Margin="0,0,6,0" />
                        <TextBlock Text="添加任务" FontSize="14" Foreground="{Binding Foreground,
                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="ProjectValidationBorder"
                Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,8"
                Background="{DynamicResource Brush.Error.Surface}"
                BorderBrush="{DynamicResource Brush.Error.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Control}"
                Visibility="Collapsed">
            <TextBlock x:Name="ProjectValidationText"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.Error.Foreground}"
                       Style="{StaticResource SecondaryTextStyle}"
                       AutomationProperties.Name="任务配置校验结果"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <Border x:Name="ProjectEmptyStatePanel"
                Grid.Row="2"
                Margin="0,16,0,0"
                Style="{StaticResource SettingsSectionPanelStyle}">
            <StackPanel MaxWidth="460"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="ProjectEmptyStateTitleText"
                           HorizontalAlignment="Center"
                           Text="项目无法加载"
                           TextAlignment="Center"
                           Style="{StaticResource SectionTitleTextStyle}" />
                <TextBlock x:Name="ProjectEmptyStateDetailText"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Text="请使用完整发布包，确保安装目录下直接包含 interface.json。"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Border>

        <Grid x:Name="TaskWorkspacePanel" Grid.Row="2" Margin="0,8,0,0"
              SizeChanged="TaskWorkspacePanel_SizeChanged" Visibility="Collapsed">
            <ScrollViewer x:Name="PlanScroll" Template="{StaticResource Scroll.Faded}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <StackPanel Margin="0,0,0,48">
                    <StackPanel x:Name="PlanItemsPanel"
                                AllowDrop="True"
                                DragLeave="PlanItemsPanel_DragLeave"
                                DragOver="PlanItemsPanel_DragOver"
                                Drop="PlanItemsPanel_Drop" />

                    <StackPanel x:Name="EmptyPlanPanel" Margin="0,16,0,0">
                        <TextBlock Text="执行计划为空" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyPlanText" Margin="0,4,0,0"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <Button x:Name="EmptyPlanAddButton" Margin="0,12,0,0" Height="32"
                                Padding="12,0" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="TaskShelfHeaderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add16" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="添加任务" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="RunItemsPanel" Visibility="Collapsed">
                <ScrollViewer Template="{StaticResource Scroll.Faded}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel x:Name="RunRows" Margin="0,0,0,48" />
                </ScrollViewer>
            </Grid>

            <Border IsHitTestVisible="False"
                    Width="{Binding ActualWidth, ElementName=TaskShelfContent}"
                    Height="{Binding ActualHeight, ElementName=TaskShelfContent}"
                    Visibility="{Binding Visibility, ElementName=TaskShelfContent}"
                    Margin="{Binding Margin, ElementName=TaskShelfContent}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12"
                    Background="{DynamicResource Brush.Surface.Popover}"
                    Effect="{DynamicResource Effect.Surface.Popover}" />
            <Border x:Name="TaskShelfContent" Visibility="Collapsed"
                    Width="362" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,0,32,0"
                    Style="{StaticResource TaskShelfSurfaceStyle}" AutomationProperties.Name="添加任务">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="8,8,8,0">
                        <TextBox x:Name="TaskSearchBox" Height="38" Padding="36,0,8,0" FontSize="14"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="搜索可用任务"
                                 TextChanged="TaskSearchBox_TextChanged">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <Grid>
                                        <Border x:Name="FocusRing" CornerRadius="11" BorderThickness="3"
                                                Visibility="Collapsed" Margin="-3"
                                                BorderBrush="{DynamicResource Brush.Primary.Surface}" />
                                        <Border x:Name="Field" CornerRadius="8" BorderThickness="1"
                                                Background="{DynamicResource Brush.Plan.Tag}"
                                                BorderBrush="{DynamicResource Brush.Transparent}" />
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" />
                                        <TextBlock x:Name="Placeholder" Text="搜索任务" IsHitTestVisible="False"
                                                   Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text.Disabled}"
                                                   Visibility="Collapsed" FontSize="14" />
                                        <ui:SymbolIcon Symbol="Search16" FontSize="16" IsHitTestVisible="False"
                                                       Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Field" Property="Background"
                                                    Value="{DynamicResource Brush.Canvas}" />
                                            <Setter TargetName="Field" Property="BorderBrush"
                                                    Value="{DynamicResource Brush.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>
                    </Grid>
                    <ScrollViewer x:Name="AvailableTasksScroll" Grid.Row="1" Margin="6,2,6,6"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False">
                        <StackPanel x:Name="AvailableTasksPanel" />
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="12,8"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}">
                        <DockPanel>
                            <TextBlock x:Name="AvailableTaskCountText" DockPanel.Dock="Right" FontSize="12"
                                       Visibility="Collapsed" Foreground="{DynamicResource Brush.Text.Disabled}" />
                            <TextBlock x:Name="TaskShelfCloseHint" DockPanel.Dock="Right" Text="Esc 关闭" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Disabled}" />
                            <Grid>
                                <TextBlock x:Name="TaskShelfHint" Text="点一下添加，可连续添加" FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Disabled}" />
                                <StackPanel x:Name="AddedTasksBadge" Orientation="Horizontal" Visibility="Collapsed">
                                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="13" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource Brush.Primary}" />
                                    <TextBlock x:Name="AddedTasksText" FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

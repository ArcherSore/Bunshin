<UserControl x:Class="Gui.Views.ShellHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
        </Style>
    </UserControl.Resources>
    <!-- WPF-UI handles the window's native caption hit testing. -->
    <Grid Height="44" Background="{DynamicResource Brush.Canvas}">
        <ui:TitleBar x:Name="TitleBar" Height="44" Padding="20,0,0,0" FontSize="14" FontWeight="Medium"
                     Foreground="{DynamicResource Brush.Text.Primary}" Background="{DynamicResource Brush.Transparent}"
                     ButtonsForeground="{DynamicResource Brush.Text.Primary}"
                     ButtonsBackground="{DynamicResource Brush.Rail.Hover}">
            <ui:TitleBar.Header>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock x:Name="PageTitle" VerticalAlignment="Center"
                                   MaxWidth="380" TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ScheduleStatusLink" Margin="8,0,0,0" Width="Auto"
                                WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed"
                                Click="ScheduleStatus_Click" ToolTip="回到首页查看运行控制">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <Ellipse x:Name="ScheduleStatusDot" Width="7" Height="7" StrokeThickness="1.3"
                                         VerticalAlignment="Center" Stroke="{DynamicResource Brush.Text.Muted}" />
                                <TextBlock x:Name="ScheduleStatusText" Text="桌面分身未启动" FontSize="14" FontWeight="Normal"
                                           Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center"
                                           Margin="6,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <DockPanel x:Name="ConfigurationTitleActions" Height="32" MaxWidth="400" Margin="12,0,0,0"
                               HorizontalAlignment="Left" Visibility="Collapsed">
                        <Button x:Name="ConfigurationMenuButton" DockPanel.Dock="Right" Margin="2,0,0,0" Cursor="Hand"
                                WindowChrome.IsHitTestVisibleInChrome="True" Click="ConfigurationMenu_Click"
                                PreviewMouseLeftButtonDown="ConfigurationAction_PreviewMouseLeftButtonDown"
                                ToolTip="更多配置操作" AutomationProperties.Name="更多配置操作">
                            <Path Data="M1,1 L4.5,4.5 L8,1" StrokeThickness="1.2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stroke="{Binding Foreground, ElementName=ConfigurationMenuButton}" />
                        </Button>
                        <Grid>
                            <Button x:Name="ConfigurationNameButton" Width="Auto" Height="32" Padding="8,0" Cursor="Hand"
                                    ToolTip="重命名配置"
                                    WindowChrome.IsHitTestVisibleInChrome="True" Click="ConfigurationName_Click"
                                    PreviewMouseLeftButtonDown="ConfigurationAction_PreviewMouseLeftButtonDown"
                                    Foreground="{DynamicResource Brush.Text.Primary}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Visibility, ElementName=ConfigurationNameEditor}" Value="Visible">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock x:Name="ConfigurationTitle" MaxWidth="354" FontSize="14"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Button>
                            <TextBox x:Name="ConfigurationNameEditor" MinWidth="140" Visibility="Collapsed"
                                     WindowChrome.IsHitTestVisibleInChrome="True"
                                     Style="{StaticResource ConfigurationNameEditorStyle}" AutomationProperties.Name="配置名称" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <Border BorderBrush="{DynamicResource Brush.Rail.Border}" BorderThickness="0,0,1,0">
                    <StackPanel x:Name="PageActions" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button x:Name="OpenDebugDirectoryButton" Click="OpenDebugDirectory_Click" ToolTip="打开调试目录"
                                AutomationProperties.Name="打开调试目录">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                        </Button>
                        <ContentPresenter
                            Content="{Binding Actions, RelativeSource={RelativeSource AncestorType=views:ShellHeader}}" />
                    </StackPanel>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>
        <Border x:Name="HeadingDivider" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Rail.Border}"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>

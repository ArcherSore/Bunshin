<UserControl x:Class="Gui.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <Style x:Key="Schedule.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="Schedule.Key" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="6,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- One segment of the day presets; the segment matching the policy's days is checked. -->
        <Style x:Key="Schedule.Preset" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <!-- A TextBlock of its own: the app-wide TextBlock style would hide the checked colour. -->
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary.Surface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.Label" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,7,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Schedule.Day" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Body}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsChecked" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.ChipRemove" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background"
                                        Value="{DynamicResource Brush.Schedule.ChipRemoveHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Schedule.AddTime" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle RadiusX="15" RadiusY="15" Fill="{TemplateBinding Background}"
                                       Stroke="{TemplateBinding BorderBrush}" StrokeDashArray="3 2" />
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                       Margin="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.TimeEditor" TargetType="TextBox">
            <Setter Property="Width" Value="46" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Inverse}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Inverse}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Text.Inverse}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="MaxLength" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Schedule.ScopeItem" TargetType="MenuItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="{DynamicResource Brush.Transparent}"
                                CornerRadius="6" Padding="10,6" MinWidth="200">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="Note" Text="{TemplateBinding Tag}" Margin="0,1,0,0"
                                           FontSize="11.5" Foreground="{DynamicResource Brush.Text.Muted}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Brush.Surface.Disabled}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Deleting cannot be undone, so the button turns red under the pointer. -->
        <Style x:Key="Schedule.Delete" TargetType="Button" BasedOn="{StaticResource NeutralIconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Error.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsPressed" Value="True" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.Error.Surface}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- The page fits the window without scrolling: the timeline's rows take the height the editor leaves, and the
         configuration list scrolls on its own when it is long. -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <Border Padding="16,12,16,16" MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="定时" VerticalAlignment="Center" Style="{StaticResource WindowTitleTextStyle}" />
                <!-- Mirrors the home page's desktop status; the full run console stays on the home page. -->
                <Button x:Name="StatusCapsule" HorizontalAlignment="Right" Height="32" Padding="12,0,10,0"
                        Style="{StaticResource BaseButtonStyle}" Background="{DynamicResource Brush.Surface}"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        ToolTip="回到首页查看运行控制" Click="StatusCapsule_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock x:Name="StatusView" Text="查看 ›" Margin="10,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Primary}" />
                    </StackPanel>
                </Button>

                <Border x:Name="NextRunBanner" Grid.Row="1" Margin="0,12,0,0" Padding="16,10" CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="NextRunIcon" Symbol="Clock24" FontSize="22"
                                       VerticalAlignment="Center" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="NextRunLabel" Text="下次运行" FontSize="12" Opacity="0.8" />
                            <TextBlock x:Name="NextRunTime" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="NextRunDetail" Margin="20,0,0,0" FontSize="12.5"
                                   VerticalAlignment="Center" LineHeight="19" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Schedule.Card}" Padding="6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="配置" Margin="10,4,10,2" FontSize="11.5"
                                       FontWeight="SemiBold" Style="{StaticResource MutedTextStyle}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel x:Name="ConfigurationList" AutomationProperties.Name="定时配置列表" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- The timeline's rows shrink first; only near the window's minimum height does this column
                         scroll, while the banner and the configuration list stay put. -->
                    <ScrollViewer x:Name="EditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=EditorScroll}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Schedule.Card}" Padding="0,6,0,10">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Bottom" Margin="66,6,12,0">
                                    <Ellipse x:Name="KeyCurrent" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="当前配置" Style="{StaticResource Schedule.Key}" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Timeline.Inactive}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="其他配置" Style="{StaticResource Schedule.Key}" />
                                    <Ellipse Width="10" Height="10" Stroke="{DynamicResource Brush.Timeline.Inactive}"
                                             StrokeThickness="2" VerticalAlignment="Center" />
                                    <TextBlock Text="已停用" Style="{StaticResource Schedule.Key}" />
                                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource Brush.Timeline.Warning}" />
                                        <TextBlock Text="!" FontSize="9" FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Text.Inverse}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="将跳过" Style="{StaticResource Schedule.Key}" />
                                    <Rectangle Width="2" Height="14" Fill="{DynamicResource Brush.Timeline.Now}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="现在" Style="{StaticResource Schedule.Key}" />
                                </WrapPanel>
                                <views:ScheduleTimeline x:Name="Timeline"
                                                        AutomationProperties.Name="一周定时时间轴" />
                            </DockPanel>
                        </Border>

                        <WrapPanel x:Name="PolicyBar" Grid.Row="1" Margin="0,12,0,0" />

                        <Border x:Name="Inspector" Grid.Row="2" Margin="0,10,0,0"
                                Style="{StaticResource Schedule.Card}" BorderThickness="4,1,1,1" CornerRadius="8"
                                Padding="12,10">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Schedule.Delete}"
                                            ToolTip="删除这条定时" AutomationProperties.Name="删除这条定时"
                                            Click="DeletePolicy_Click">
                                        <ui:SymbolIcon Symbol="Delete20" FontSize="16" />
                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:ToggleSwitch x:Name="PolicyEnabled" OnContent="{x:Null}"
                                                         OffContent="{x:Null}" VerticalAlignment="Center"
                                                         AutomationProperties.Name="启用这条定时"
                                                         Click="PolicyEnabled_Click" />
                                        <TextBox x:Name="PolicyName" Width="220" Margin="10,0,0,0" Padding="2,4"
                                                 MinHeight="32" VerticalContentAlignment="Center" MaxLength="40"
                                                 AutomationProperties.Name="定时名称"
                                                 LostKeyboardFocus="PolicyName_LostKeyboardFocus"
                                                 KeyDown="PolicyName_KeyDown" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="星期" Margin="2,5,0,0" Style="{StaticResource Schedule.Label}" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="DayChips" Orientation="Horizontal"
                                                    AutomationProperties.Name="星期" />
                                        <Border Margin="8,0,0,0" Padding="2" CornerRadius="6" BorderThickness="1"
                                                BorderBrush="{DynamicResource Brush.Border}"
                                                VerticalAlignment="Center" AutomationProperties.Name="星期预设">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton x:Name="PresetWeekdays" Content="工作日" Tag="Weekdays"
                                                              Style="{StaticResource Schedule.Preset}"
                                                              Click="QuickDays_Click" />
                                                <ToggleButton x:Name="PresetWeekend" Content="周末" Tag="Weekend"
                                                              Style="{StaticResource Schedule.Preset}"
                                                              Click="QuickDays_Click" />
                                                <ToggleButton x:Name="PresetEveryDay" Content="每天" Tag="All"
                                                              Style="{StaticResource Schedule.Preset}"
                                                              Click="QuickDays_Click" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock Text="时间" Style="{StaticResource Schedule.Label}" />
                                    <WrapPanel x:Name="TimeChips" Margin="0,0,0,-6" AutomationProperties.Name="时间" />
                                </DockPanel>
                                <Border x:Name="ShareHint" Margin="0,10,0,0" Padding="10,4,4,4" CornerRadius="6"
                                        Background="{DynamicResource Brush.Surface.Subdued}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" MinHeight="26" Height="26" Padding="8,0"
                                                FontSize="12" FontWeight="Normal"
                                                Style="{StaticResource SubtleButtonStyle}"
                                                Click="ShareHintClose_Click">
                                            <TextBlock Text="知道了" Foreground="{DynamicResource Brush.Text.Muted}" />
                                        </Button>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="勾选的星期共用这些时间。" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <Button x:Name="SplitRestButton" Margin="4,0,0,0" MinHeight="26"
                                                    Height="26" Padding="6,0" FontSize="12" FontWeight="Normal"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Click="SplitRest_Click" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <StackPanel x:Name="IssuesPanel" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="EmptyHint" Grid.Row="2" Margin="2,10,0,0"
                                   Text="点击时间轴创建第一条定时"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>

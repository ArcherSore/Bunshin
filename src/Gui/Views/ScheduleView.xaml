<UserControl x:Class="Gui.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Color.Indigo.600}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Color.Indigo.700}" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Color.Indigo.800}" />
        <Style x:Key="Schedule.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="Schedule.Key" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="6,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Schedule.Quick" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="16,12,16,16">
            <Grid Height="36">
                <TextBlock Text="定时" VerticalAlignment="Center" Style="{StaticResource WindowTitleTextStyle}" />
                <!-- Mirrors the home page's desktop status; the full run console stays on the home page. -->
                <Button x:Name="StatusCapsule" HorizontalAlignment="Right" Height="32" Padding="12,0,10,0"
                        Style="{StaticResource BaseButtonStyle}" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        ToolTip="回到首页查看运行控制" Click="StatusCapsule_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="16"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                        <TextBlock x:Name="StatusView" Text="查看 ›" Margin="10,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border x:Name="NextRunBanner" Margin="0,12,0,0" Padding="16,10" CornerRadius="10">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="NextRunIcon" Symbol="Clock24" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NextRunLabel" Text="下次运行" FontSize="12" Opacity="0.8" />
                        <TextBlock x:Name="NextRunTime" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="NextRunDetail" Margin="20,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                               LineHeight="19" />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Schedule.Card}" Padding="6" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="配置" Margin="10,4,10,2" FontSize="11.5" FontWeight="SemiBold"
                                   Style="{StaticResource MutedTextStyle}" />
                        <StackPanel x:Name="ConfigurationList" AutomationProperties.Name="定时配置列表" />
                        <Border Margin="0,4,0,0" BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource Brush.Border.Subtle}">
                            <TextBlock Text="同时到点时，靠前的先运行" Margin="10,8,10,4" FontSize="11"
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Schedule.Card}" Padding="0,6,0,10">
                        <StackPanel>
                            <views:ScheduleTimeline x:Name="Timeline"
                                                    AutomationProperties.Name="一周定时时间轴" />
                            <WrapPanel Margin="66,6,12,0">
                                <Ellipse x:Name="KeyCurrent" Width="10" Height="10" VerticalAlignment="Center" />
                                <TextBlock Text="当前配置" Style="{StaticResource Schedule.Key}" />
                                <Ellipse Width="8" Height="8" Fill="#A3AFBF" VerticalAlignment="Center" />
                                <TextBlock Text="其他配置" Style="{StaticResource Schedule.Key}" />
                                <Ellipse Width="10" Height="10" Stroke="#A3AFBF" StrokeThickness="2"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="已停用" Style="{StaticResource Schedule.Key}" />
                                <Grid Width="12" Height="12" VerticalAlignment="Center">
                                    <Ellipse Fill="#D08A16" />
                                    <TextBlock Text="!" FontSize="9" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="将跳过" Style="{StaticResource Schedule.Key}" />
                                <Rectangle Width="2" Height="14" Fill="#E03131" VerticalAlignment="Center" />
                                <TextBlock Text="现在" Style="{StaticResource Schedule.Key}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel x:Name="PolicyBar" Margin="0,12,0,0" />

                    <Border x:Name="Inspector" Margin="0,10,0,0" Style="{StaticResource Schedule.Card}"
                            BorderThickness="4,1,1,1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <DockPanel x:Name="PolicyRow" LastChildFill="False">
                                <ui:ToggleSwitch x:Name="PolicyEnabled" OnContent="{x:Null}" OffContent="{x:Null}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="启用这条定时"
                                                 Click="PolicyEnabled_Click" />
                                <TextBox x:Name="PolicyName" Width="180" Margin="10,0,0,0"
                                         VerticalContentAlignment="Center" MaxLength="40"
                                         AutomationProperties.Name="定时名称"
                                         LostKeyboardFocus="PolicyName_LostKeyboardFocus"
                                         KeyDown="PolicyName_KeyDown" />
                                <TextBlock x:Name="PolicySummary" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}" />
                                <Button DockPanel.Dock="Right" Width="30" Height="30" Margin="4,0,0,0"
                                        Style="{StaticResource NeutralIconButtonStyle}" ToolTip="删除这条定时"
                                        AutomationProperties.Name="删除这条定时" Click="DeletePolicy_Click">
                                    <ui:SymbolIcon Symbol="Delete20" FontSize="16" />
                                </Button>
                                <Button DockPanel.Dock="Right" Content="每天" Tag="All"
                                        Style="{StaticResource Schedule.Quick}" Click="QuickDays_Click" />
                                <Button DockPanel.Dock="Right" Content="周末" Tag="Weekend"
                                        Style="{StaticResource Schedule.Quick}" Click="QuickDays_Click" />
                                <Button DockPanel.Dock="Right" Content="工作日" Tag="Weekdays"
                                        Style="{StaticResource Schedule.Quick}" Click="QuickDays_Click" />
                            </DockPanel>
                            <StackPanel x:Name="SelectedTimeRow" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="SelectedTimeText" FontFamily="{StaticResource FontFamily.Monospace}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBox x:Name="SelectedTimeInput" Width="80" Margin="12,0,0,0"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="精确时间"
                                         LostKeyboardFocus="SelectedTimeInput_LostKeyboardFocus"
                                         KeyDown="SelectedTimeInput_KeyDown" />
                                <Button Margin="8,0,0,0" Height="30" Padding="10,0" Content="删除"
                                        Style="{StaticResource NeutralSecondaryButtonStyle}"
                                        Click="DeleteSelectedTime_Click" />
                                <TextBlock x:Name="SelectedTimeShared" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="EditHint" Margin="0,8,0,0"
                                       Text="点击空白处添加 · 拖动调整 · 双击删除"
                                       Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <StackPanel x:Name="IssuesPanel" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="EmptyHint" Margin="2,10,0,0" Text="点击时间轴创建第一条定时"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

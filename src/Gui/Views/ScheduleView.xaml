<UserControl x:Class="Gui.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <Style x:Key="Schedule.Button" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.Secondary" TargetType="Button" BasedOn="{StaticResource Schedule.Button}">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Schedule.Secondary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.SecondaryHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.Icon" TargetType="Button" BasedOn="{StaticResource Schedule.Button}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        </Style>
        <Style x:Key="Schedule.Delete" TargetType="Button" BasedOn="{StaticResource Schedule.Icon}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Error.Surface}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.Link" TargetType="Button" BasedOn="{StaticResource Schedule.Button}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Schedule.Link}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.AccentSurface}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.PolicyRow" TargetType="Button" BasedOn="{StaticResource Schedule.Button}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="56,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Schedule.Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Schedule.SwitchOff}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="2">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left"
                                     Fill="{DynamicResource Brush.Text.Inverse}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.Preset" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.PresetSelected}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.Day" TargetType="ToggleButton" BasedOn="{StaticResource Schedule.Preset}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.SecondaryHover}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.DaySelected}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Schedule.DaySelectedText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.PolicyName" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Schedule.Hover}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Schedule.TimeEditor" TargetType="TextBox">
            <Setter Property="Width" Value="35" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
            <Setter Property="SelectionOpacity" Value="0.35" />
            <Setter Property="MaxLength" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Schedule.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="0,6,8,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Schedule.Key" TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Schedule.KeyMarker" TargetType="Rectangle">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="12" />
            <Setter Property="RadiusX" Value="3" />
            <Setter Property="RadiusY" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Schedule.Menu" TargetType="ContextMenu" BasedOn="{StaticResource FloatingContextMenuStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Schedule.Menu}" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <views:ShadowBorder Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"
                                            Margin="14,6,14,20" Padding="{TemplateBinding Padding}"
                                            Shadow="{DynamicResource Effect.Dialog}" SnapsToDevicePixels="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False" MaxHeight="350">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </views:ShadowBorder>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Schedule.ScopeItem" TargetType="MenuItem">
            <Setter Property="MinWidth" Value="206" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="{DynamicResource Brush.Transparent}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <StackPanel>
                                <TextBlock Text="{TemplateBinding Header}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" TextWrapping="Wrap"
                                           Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="Note" Text="{TemplateBinding Tag}" Margin="0,1,0,0" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Brush.Schedule.Hover}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Border MaxWidth="1024" Padding="32,32,32,48">
            <StackPanel>
                <WrapPanel Margin="0,0,0,26">
                    <TextBlock Text="本周" FontSize="16" FontWeight="Medium" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Text="下次运行" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"
                               Style="{StaticResource MutedTextStyle}" />
                    <TextBlock x:Name="NextRunDetail" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                </WrapPanel>

                <views:ScheduleTimeline x:Name="Timeline" AutomationProperties.Name="一周定时时间轴" />
                <WrapPanel Margin="48,12,0,0">
                    <Rectangle x:Name="KeyCurrent" Style="{StaticResource Schedule.KeyMarker}"
                               Fill="{DynamicResource Brush.Timeline.Selected}" />
                    <TextBlock Text="选中的定时" Style="{StaticResource Schedule.Key}" />
                    <Rectangle Style="{StaticResource Schedule.KeyMarker}" Fill="{DynamicResource Brush.Timeline.Sibling}" />
                    <TextBlock Text="本配置其他定时" Style="{StaticResource Schedule.Key}" />
                    <Rectangle Style="{StaticResource Schedule.KeyMarker}" Fill="{DynamicResource Brush.Timeline.Other}" />
                    <TextBlock Text="其他配置" Style="{StaticResource Schedule.Key}" />
                    <Rectangle Style="{StaticResource Schedule.KeyMarker}" Stroke="{DynamicResource Brush.Timeline.Inactive}"
                               StrokeDashArray="2 2" />
                    <TextBlock Text="已停用" Style="{StaticResource Schedule.Key}" />
                    <Rectangle Style="{StaticResource Schedule.KeyMarker}" Fill="{DynamicResource Brush.Timeline.Warning}" />
                    <TextBlock Text="将跳过" Style="{StaticResource Schedule.Key}" />
                    <Rectangle Width="2" RadiusX="1" RadiusY="1" Style="{StaticResource Schedule.KeyMarker}"
                               Fill="{DynamicResource Brush.Timeline.Now}" />
                    <TextBlock Text="现在" Style="{StaticResource Schedule.Key}" />
                </WrapPanel>

                <Border Height="1" Margin="0,24" Background="{DynamicResource Brush.Border}" />
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="NewPolicyButton" DockPanel.Dock="Right" Style="{StaticResource Schedule.Secondary}"
                            AutomationProperties.Name="新建定时" Click="NewPolicy_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add16" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="新建定时" FontSize="14" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConfigurationPicker" DockPanel.Dock="Left" Margin="-8,0,10,0"
                            Style="{StaticResource Schedule.Button}" Click="ConfigurationPicker_Click">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource Schedule.Menu}" Placement="Bottom" />
                        </Button.ContextMenu>
                        <DockPanel MaxWidth="210">
                            <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronDown16" FontSize="14" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock x:Name="ConfigurationName" FontSize="14" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <TextBlock x:Name="PolicyCount" VerticalAlignment="Center" FontSize="14"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource MutedTextStyle}" />
                </DockPanel>

                <StackPanel x:Name="PolicyRows">
                    <Border x:Name="Inspector" Margin="0,0,0,4" Padding="12,8,8,16" CornerRadius="12"
                            Background="{DynamicResource Brush.Schedule.Card}" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="CollapsePolicy" DockPanel.Dock="Right" Style="{StaticResource Schedule.Icon}"
                                        ToolTip="收起" AutomationProperties.Name="收起这条定时" Click="CollapsePolicy_Click">
                                    <ui:SymbolIcon Symbol="ChevronUp16" FontSize="14" />
                                </Button>
                                <Button DockPanel.Dock="Right" Margin="0,0,12,0" Style="{StaticResource Schedule.Delete}"
                                        ToolTip="删除这条定时" AutomationProperties.Name="删除这条定时"
                                        Click="DeletePolicy_Click">
                                    <ui:SymbolIcon Symbol="Delete16" FontSize="16" />
                                </Button>
                                <ToggleButton x:Name="PolicyEnabled" DockPanel.Dock="Left"
                                              Style="{StaticResource Schedule.Switch}" VerticalAlignment="Center"
                                              AutomationProperties.Name="启用这条定时" Click="PolicyEnabled_Click" />
                                <TextBox x:Name="PolicyName" MaxWidth="240" HorizontalAlignment="Left" MinWidth="120"
                                         Style="{StaticResource Schedule.PolicyName}" MaxLength="40"
                                         AutomationProperties.Name="定时名称" LostKeyboardFocus="PolicyName_LostKeyboardFocus"
                                         KeyDown="PolicyName_KeyDown" />
                            </DockPanel>
                            <DockPanel Margin="44,12,0,0">
                                <TextBlock Text="星期" Style="{StaticResource Schedule.FieldLabel}" />
                                <WrapPanel>
                                    <StackPanel x:Name="DayChips" Orientation="Horizontal"
                                                AutomationProperties.Name="星期" />
                                    <Border Margin="12,0,0,0" Padding="2" CornerRadius="8"
                                            Background="{DynamicResource Brush.Schedule.Field}"
                                            AutomationProperties.Name="快速选择">
                                        <StackPanel Orientation="Horizontal">
                                            <ToggleButton x:Name="PresetWeekdays" Content="工作日" Tag="Weekdays"
                                                          Margin="0,0,2,0" Style="{StaticResource Schedule.Preset}"
                                                          Click="QuickDays_Click" />
                                            <ToggleButton x:Name="PresetWeekend" Content="周末" Tag="Weekend"
                                                          Margin="0,0,2,0" Style="{StaticResource Schedule.Preset}"
                                                          Click="QuickDays_Click" />
                                            <ToggleButton x:Name="PresetEveryDay" Content="每天" Tag="All"
                                                          Style="{StaticResource Schedule.Preset}" Click="QuickDays_Click" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </DockPanel>
                            <DockPanel Margin="44,12,0,0">
                                <TextBlock Text="时间" Style="{StaticResource Schedule.FieldLabel}" />
                                <WrapPanel x:Name="TimeChips" Margin="0,0,0,-8" AutomationProperties.Name="时间" />
                            </DockPanel>
                            <Button x:Name="SplitRestButton" Margin="86,8,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource Schedule.Link}" Click="SplitRest_Click" />
                            <Border x:Name="ShareHint" Margin="92,8,0,0" Padding="8,2" CornerRadius="8"
                                    Background="{DynamicResource Brush.Schedule.Field}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="知道了" Height="24"
                                            Style="{StaticResource Schedule.Button}" Click="ShareHintClose_Click" />
                                    <TextBlock Text="勾选的星期共用这些时间。" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                                </DockPanel>
                            </Border>
                            <StackPanel x:Name="IssuesPanel" Margin="44,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="EmptyHint" Margin="0,8,0,0" Text="点击时间轴创建第一条定时"
                           Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

<ContextMenu x:Class="Gui.Views.ConfigurationMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Placement="Bottom" VerticalOffset="2" MinWidth="242" HasDropShadow="True"
             FontFamily="{StaticResource FontFamily.Ui}" FontSize="14"
             Foreground="{DynamicResource Brush.Text.Primary}"
             Background="{DynamicResource Brush.Canvas}" BorderBrush="{DynamicResource Brush.Border}">
    <ContextMenu.Resources>
        <Style x:Key="ConfigurationMenu.Item" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                    Background="{DynamicResource Brush.Transparent}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="0,0,12,0"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Header}" VerticalAlignment="Center"
                                               FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                               FontSize="12" Margin="10,0,2,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Disabled}" />
                                    <ui:SymbolIcon x:Name="Chevron" Grid.Column="2" Symbol="ChevronRight16" FontSize="11"
                                                   Visibility="Collapsed" Foreground="{DynamicResource Brush.Text.Muted}" />
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-2"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Margin="9,4,13,14" CornerRadius="12" Padding="6" BorderThickness="1"
                                        Background="{DynamicResource Brush.Surface.Popover}" BorderBrush="{DynamicResource Brush.Border}"
                                        Effect="{DynamicResource Effect.Surface.Popover}" MinWidth="220">
                                    <ScrollViewer MaxHeight="348" CanContentScroll="False"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle" IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Icon" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource Brush.Rail.Border}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContextMenu.Resources>
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border Margin="9,4,13,14" Padding="6" CornerRadius="12" BorderThickness="1"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"
                    Effect="{DynamicResource Effect.Surface.Popover}">
                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
</ContextMenu>

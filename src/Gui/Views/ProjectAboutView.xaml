<UserControl x:Class="Gui.Views.ProjectAboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ContentControl x:Name="Description" Margin="0,16,0,8" Focusable="False" />
        <StackPanel x:Name="ContactRow" Margin="0,24,0,0">
            <TextBlock Text="联系方式" FontSize="14"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <ContentControl x:Name="Contact" Margin="0,2,0,0" Focusable="False" />
        </StackPanel>
    </StackPanel>
</UserControl>

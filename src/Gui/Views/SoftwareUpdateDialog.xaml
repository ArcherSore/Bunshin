<UserControl x:Class="Gui.Views.SoftwareUpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views">
    <UserControl.Resources>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DownloadProgressStyle" TargetType="ProgressBar">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Dialog.Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
            <Style.Triggers>
                <Trigger Property="IsIndeterminate" Value="False">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" CornerRadius="2"
                                            Background="{TemplateBinding Background}" />
                                    <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left"
                                            Background="{TemplateBinding Foreground}" />
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <views:ShadowBorder x:Name="Card" Background="{DynamicResource Brush.Surface.Popover}"
                        BorderBrush="{DynamicResource Brush.Dialog.Border}" BorderThickness="1"
                        CornerRadius="16" Shadow="{DynamicResource Effect.Dialog.Update}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="23,15,11,0" Height="36">
                <Button x:Name="CloseUpdateButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Width="28" Height="28" MinHeight="28" Padding="6" VerticalAlignment="Center"
                        ToolTip="关闭（Esc）" AutomationProperties.Name="关闭软件更新">
                    <Path Width="16" Height="16" Data="M4,4 L12,12 M12,4 L4,12"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <TextBlock Text="软件更新" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" Margin="23,8,23,0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="CheckingPanel" Orientation="Horizontal" Margin="0,12,0,4" Height="24">
                        <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True"
                                         CoverRingVisibility="Visible"
                                         CoverRingStroke="{DynamicResource Brush.Dialog.Secondary}"
                                         Foreground="{DynamicResource Brush.Primary}" />
                        <TextBlock Text="正在检查更新…" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <Grid x:Name="VersionPanel" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Dialog.Action}">
                            <TextBlock Text="B" FontSize="22" FontFamily="{StaticResource FontFamily.Wordmark}"
                                       Foreground="{DynamicResource Brush.Dialog.Action.Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StateTitle" FontSize="14" FontWeight="Medium" LineHeight="22"
                                       LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="VersionSummary" FontSize="13" LineHeight="22"
                                       AutomationProperties.LiveSetting="Polite"
                                       LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock x:Name="AvailableVersion" TextWrapping="Wrap"
                                       Typography.NumeralAlignment="Tabular" LineHeight="26"
                                       LineStackingStrategy="BlockLineHeight">
                                <Run x:Name="TargetVersion" FontSize="22" FontWeight="Medium" /><Run Text="  " />
                                <Run x:Name="InstalledVersion" FontSize="13"
                                     Foreground="{DynamicResource Brush.Text.Muted}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ResultMessage" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="22"
                               LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Brush.Text.Muted}" />
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="4" Margin="0,16,0,0"
                                 Style="{StaticResource DownloadProgressStyle}" AutomationProperties.Name="下载进度" />
                    <Border x:Name="NotesPanel" Margin="0,12,0,0" Padding="14,12" CornerRadius="12"
                            Background="{DynamicResource Brush.Dialog.Section}">
                        <StackPanel>
                            <TextBlock Text="更新内容" FontSize="14" FontWeight="Medium" LineHeight="22"
                                       LineStackingStrategy="BlockLineHeight" Margin="0,0,0,6" />
                            <FlowDocumentScrollViewer x:Name="NotesViewer" MaxHeight="260"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      IsToolBarVisible="False" Zoom="100" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="UpdateDownloadStatus" FontSize="14" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Text.Muted}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" Margin="23,20,23,19" LastChildFill="False">
                <Button x:Name="ReleaseNotesButton" DockPanel.Dock="Left" Content="查看更新说明"
                        Style="{StaticResource GhostButton}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="DialogCheckUpdateButton" Style="{StaticResource DialogSecondaryButtonStyle}" />
                    <Button x:Name="CheckingCloseButton" Content="关闭" Style="{StaticResource DialogSecondaryButtonStyle}" />
                    <Button x:Name="LaterUpdateButton" Content="稍后" Style="{StaticResource DialogSecondaryButtonStyle}" />
                    <Button x:Name="CancelDownloadButton" Content="取消下载" Style="{StaticResource DialogSecondaryButtonStyle}" />
                    <Button x:Name="DownloadUpdateButton" Content="立即更新" Margin="8,0,0,0"
                            Style="{StaticResource DialogPrimaryButtonStyle}" />
                    <Button x:Name="InstallUpdateButton" Content="安装并重启" Margin="8,0,0,0"
                            Style="{StaticResource DialogPrimaryButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </views:ShadowBorder>
</UserControl>

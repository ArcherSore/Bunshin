<UserControl x:Class="Gui.Views.ProjectReaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:Gui.Views"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.ControlTabNavigation="Cycle"
             SizeChanged="Reader_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="Reader.CloseButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Section}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Active}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button x:Name="ReaderScrim" Background="{DynamicResource Brush.Overlay.Reader}"
                Focusable="False" IsTabStop="False" Click="Dismiss_Click"
                AutomationProperties.Name="关闭阅读遮罩">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        <Grid x:Name="ReaderDialog" MaxWidth="512" Margin="16,0" VerticalAlignment="Center"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ReaderScale" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <views:ShadowBorder Grid.RowSpan="3" Background="{DynamicResource Brush.Surface.Popover}"
                                BorderBrush="{DynamicResource Brush.Dialog.Border}" BorderThickness="1"
                                CornerRadius="16" Shadow="{DynamicResource Effect.Dialog.Welcome}" />
            <Grid Margin="24,16,12,0" Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Viewbox x:Name="WelcomeIcon">
                        <Canvas Width="16" Height="16">
                            <Path Stroke="{DynamicResource Brush.Text.Muted}" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8 2.2l1.4 3.6 3.6 1.4-3.6 1.4L8 12.2 6.6 8.6 3 7.2l3.6-1.4z M12.6 11.2v2.6 M11.3 12.5h2.6" />
                        </Canvas>
                    </Viewbox>
                    <ui:SymbolIcon x:Name="ReaderSymbol" FontSize="18" Foreground="{DynamicResource Brush.Text.Muted}" />
                </Grid>
                <TextBlock x:Name="ReaderTitle" Grid.Column="1" FontSize="16" FontWeight="Medium"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <Button x:Name="ReaderCloseButton" Grid.Column="2" Click="Dismiss_Click" ToolTip="关闭（Esc）"
                        VerticalAlignment="Center" Style="{StaticResource Reader.CloseButton}"
                        AutomationProperties.Name="关闭（Esc）">
                    <Canvas Width="16" Height="16">
                        <Path Data="M4 4l8 8 M12 4l-8 8" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Button>
            </Grid>
            <FlowDocumentScrollViewer x:Name="ReaderViewer" Grid.Row="1" Margin="24,8,24,0" MaxHeight="420"
                                      Zoom="100" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                      HorizontalScrollBarVisibility="Disabled" />
            <Button x:Name="ReaderDismissButton" Grid.Row="2" Margin="24,20" HorizontalAlignment="Right"
                    Content="我知道了" Click="Dismiss_Click" Style="{StaticResource DialogPrimaryButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>

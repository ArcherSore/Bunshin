<UserControl x:Class="Gui.Views.RuntimePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:Gui.Models"
             AutomationProperties.Name="运行面板">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Panel.BooleanToVisibility" />
        <Style x:Key="Panel.OutlineIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="Panel.RowIcon" TargetType="Path" BasedOn="{StaticResource Panel.OutlineIcon}">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="1" />
                </Setter.Value>
            </Setter>
        </Style>
        <GeometryGroup x:Key="Panel.CalendarIcon">
            <RectangleGeometry Rect="2.25,3.25,11.5,10.5" RadiusX="1.5" RadiusY="1.5" />
            <PathGeometry Figures="M2.25,6.5 H13.75 M5.5,1.75 V4.75 M10.5,1.75 V4.75" />
        </GeometryGroup>
        <Style x:Key="Panel.QuietButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Rail.Active}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Panel.TextAction" TargetType="Button" BasedOn="{StaticResource Panel.QuietButton}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource Brush.Transparent}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Panel.SectionToggle" TargetType="Button" BasedOn="{StaticResource Panel.QuietButton}">
            <Setter Property="Padding" Value="16,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}" Background="{DynamicResource Brush.Transparent}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" />
                                <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronDown16" Opacity="0"
                                    Margin="5,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" />
                                <TextBlock Text="{TemplateBinding AutomationProperties.HelpText}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Collapsed">
                                <Setter TargetName="Chevron" Property="Symbol" Value="ChevronRight16" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                                <Setter TargetName="Chevron" Property="Opacity" Value="1" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The colour of one Plan Item's state, shared by the run result's meter and legend squares. -->
        <Style x:Key="Panel.RunMark" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Text.Disabled}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Succeeded">
                    <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Stopped">
                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Unfinished segments read as the empty track. -->
        <Style x:Key="Panel.RunSegment" TargetType="Border" BasedOn="{StaticResource Panel.RunMark}">
            <Setter Property="Background" Value="{DynamicResource Brush.Progress.Track}" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="1.5" />
        </Style>
        <Style x:Key="Panel.Section" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rail.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="Panel.SectionHeader" TargetType="DockPanel">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,6,8,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        </Style>
        <Style x:Key="Panel.Action" TargetType="Button" BasedOn="{StaticResource Panel.QuietButton}">
            <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Panel.Recover" TargetType="Button" BasedOn="{StaticResource Panel.Action}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Error.Surface}" />
        </Style>
        <Style x:Key="Panel.ScheduleToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Brush.RuntimePanel.SwitchOff}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Style="{StaticResource SwitchTrackStyle}">
                            <Ellipse x:Name="Knob" Style="{StaticResource SwitchKnobStyle}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Brush.Canvas}" Padding="1,0,0,0">
        <Grid x:Name="Sections">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="DesktopSection" Style="{StaticResource Panel.Section}" KeyboardNavigation.TabNavigation="Local">
                <StackPanel>
                    <DockPanel Style="{StaticResource Panel.SectionHeader}">
                        <Button x:Name="RuntimeMoreButton" DockPanel.Dock="Right" Width="28" Height="28"
                                Padding="0" VerticalAlignment="Center" Cursor="Hand"
                                Style="{StaticResource Panel.QuietButton}" Click="RuntimeMoreButton_Click"
                                ToolTip="分身管理" AutomationProperties.Name="分身管理">
                            <ui:SymbolIcon Symbol="MoreHorizontal20" FontSize="15" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="RuntimeMoreMenu" MinWidth="132"
                                             Style="{StaticResource FloatingContextMenuStyle}"
                                             Background="{DynamicResource Brush.Surface.Popover}">
                                    <MenuItem x:Name="StartSessionMenuItem" Header="仅打开分身"
                                              Style="{StaticResource TrayMenuItemStyle}"
                                              ToolTip="打开分身，不运行任务" />
                                    <MenuItem x:Name="EndEnvironmentMenuItem" Header="关闭分身" Visibility="Collapsed"
                                              ToolTipService.ShowOnDisabled="True">
                                        <MenuItem.Style>
                                            <Style TargetType="MenuItem" BasedOn="{StaticResource TrayMenuItemStyle}">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
                                                <Setter Property="Background" Value="{DynamicResource Brush.Error.Surface}" />
                                            </Style>
                                        </MenuItem.Style>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="DesktopSectionToggle" Content="桌面分身" Style="{StaticResource Panel.SectionToggle}" />
                    </DockPanel>
                    <StackPanel x:Name="RuntimeControlCard" Margin="6,0,6,12">
                        <DockPanel MinHeight="32" Margin="10,0">
                            <Button x:Name="DesktopViewButton" DockPanel.Dock="Right" Padding="4,2,0,2"
                                    Style="{StaticResource Panel.TextAction}" ToolTipService.ShowOnDisabled="True">
                                <TextBlock x:Name="DesktopViewText" Text="显示窗口" TextDecorations="Underline">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Foreground"
                                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Primary.Foreground}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             Value="Onboarding">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Panel.RowIcon}" Margin="0,0,11,0">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="1.75,2.75,12.5,8.5" RadiusX="1.5" RadiusY="1.5" />
                                            <PathGeometry Figures="M5.5,13.5 H10.5 M8,11.25 V13.5" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                                <Border x:Name="RuntimeStatusPill">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="SessionStatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RuntimeStatusText" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                        <Button x:Name="NextRunRow" MinHeight="32" Padding="10,0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Style="{StaticResource Panel.QuietButton}" AutomationProperties.Name="下次运行，打开定时页"
                                AutomationProperties.HelpText="{Binding Text, ElementName=NextRunText}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Style="{StaticResource Panel.RowIcon}" Margin="0,0,11,0">
                                        <Path.Data>
                                            <GeometryGroup>
                                                <EllipseGeometry Center="8,8" RadiusX="5.75" RadiusY="5.75" />
                                                <PathGeometry Figures="M8,5 V8.2 L10,9.5" />
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                    <TextBlock Text="下次运行" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="NextRunText" Margin="12,0,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                           FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" />
                            </DockPanel>
                        </Button>
                        <TextBlock x:Name="RecoveryTitleText" Visibility="Collapsed" Margin="37,6,10,0"
                                   TextWrapping="Wrap" FontSize="14"
                                   Foreground="{DynamicResource Brush.Error.Foreground}" />
                        <TextBlock x:Name="RuntimeStatusDetail" Margin="37,3,10,0" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <Grid Margin="10,0">
                            <Button x:Name="RetryEnvironmentButton" Visibility="Collapsed" Content="重试准备运行环境"
                                    Style="{StaticResource Panel.Action}"
                                    AutomationProperties.Name="重试准备运行环境" />
                            <Button x:Name="RecoverEnvironmentButton" Visibility="Collapsed" Content="结束桌面分身"
                                    Style="{StaticResource Panel.Recover}" ToolTipService.ShowOnDisabled="True"
                                    AutomationProperties.Name="结束桌面分身" />
                            <StackPanel x:Name="RuntimeHeaderProgressRing" Visibility="Collapsed" Orientation="Horizontal"
                                        Margin="27,7,0,0">
                                <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,7,0" />
                                <TextBlock x:Name="RuntimeProgressText" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="RunResultSection" Grid.Row="1" Style="{StaticResource Panel.Section}" Visibility="Collapsed"
                    KeyboardNavigation.TabNavigation="Local">
                <StackPanel>
                    <DockPanel Style="{StaticResource Panel.SectionHeader}">
                        <Button x:Name="RunResultSectionToggle" Content="本次运行" Style="{StaticResource Panel.SectionToggle}" />
                    </DockPanel>
                    <StackPanel x:Name="RunResultSectionBody" Margin="6,0,6,12">
                        <!-- The application text style outranks an inherited size, so each text states its own. -->
                        <DockPanel MinHeight="30" Margin="10,0">
                            <TextBlock x:Name="RunResultTime" DockPanel.Dock="Right" Margin="12,0,0,0" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock x:Name="RunResultCount" FontSize="14" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <ItemsControl x:Name="RunResultMeter" Margin="9,4,9,6" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Panel.RunSegment}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="RunResultOutcomes" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel MinHeight="30" Margin="10,0">
                                        <!-- The square sits in the 16 wide icon slot the other panel rows use. -->
                                        <Border Style="{StaticResource Panel.RunMark}" Width="10" Height="10"
                                                CornerRadius="3" Margin="3,1,14,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding Value}" FontSize="14" Margin="12,0,0,0"
                                                   TextAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="RunResultAllToggle" Style="{StaticResource Panel.QuietButton}" MinHeight="30"
                                Padding="10,0" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                Click="RunResultAllToggle_Click" AutomationProperties.Name="展开全部任务">
                            <DockPanel>
                                <ui:SymbolIcon x:Name="RunResultAllChevron" Symbol="ChevronRight16" Width="16"
                                               FontSize="12" Margin="0,0,11,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                <TextBlock x:Name="RunResultAllCount" DockPanel.Dock="Right" FontSize="14"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Muted}" />
                                <TextBlock Text="全部任务" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </DockPanel>
                        </Button>
                        <!-- A longer plan scrolls here; code fits the height to the panel. -->
                        <ScrollViewer x:Name="RunResultAllScroll" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="RunResultAllItems" Focusable="False"
                                          AutomationProperties.Name="全部任务">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Rows start where the 全部任务 text does. -->
                                        <Grid MinHeight="28" Margin="37,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TaskName" Text="{Binding Name}" FontSize="14"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            <TextBlock x:Name="TaskStatus" Grid.Column="1" Text="{Binding Status}"
                                                       FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter TargetName="TaskStatus" Property="Foreground"
                                                        Value="{DynamicResource Brush.Primary.Foreground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                <Setter TargetName="TaskStatus" Property="Foreground"
                                                        Value="{DynamicResource Brush.Error.Foreground}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Pending">
                                                <Setter TargetName="TaskName" Property="Foreground"
                                                        Value="{DynamicResource Brush.Text.Disabled}" />
                                                <Setter TargetName="TaskStatus" Property="Foreground"
                                                        Value="{DynamicResource Brush.Text.Disabled}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="NotRun">
                                                <Setter TargetName="TaskName" Property="Foreground"
                                                        Value="{DynamicResource Brush.Text.Disabled}" />
                                                <Setter TargetName="TaskStatus" Property="Foreground"
                                                        Value="{DynamicResource Brush.Text.Disabled}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="ScheduleSection" Grid.Row="2" Style="{StaticResource Panel.Section}"
                    KeyboardNavigation.TabNavigation="Local">
                <StackPanel>
                    <DockPanel Style="{StaticResource Panel.SectionHeader}">
                        <Button x:Name="RuntimeSchedulePageButton" DockPanel.Dock="Right" Width="26"
                                Style="{StaticResource Panel.QuietButton}" ToolTip="打开定时页"
                                AutomationProperties.Name="打开定时页">
                            <Viewbox Width="14" Height="14">
                                <Path Style="{StaticResource Panel.OutlineIcon}"
                                      Data="M6.5,3.5 H3.5 V12.5 H12.5 V9.5 M9,3 H13 V7 M13,3 L7.5,8.5" />
                            </Viewbox>
                        </Button>
                        <Button x:Name="ScheduleSectionToggle" Content="定时" Style="{StaticResource Panel.SectionToggle}" />
                    </DockPanel>
                    <Grid x:Name="ScheduleSectionBody" Margin="16,0,16,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="192">
                            <ItemsControl x:Name="RuntimeSchedulePolicies">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel MinHeight="32">
                                            <ToggleButton DockPanel.Dock="Right" Margin="8,0,0,0"
                                                Style="{StaticResource Panel.ScheduleToggle}"
                                                IsChecked="{Binding Enabled, Mode=OneWay}" Click="SchedulePolicyToggle_Click"
                                                AutomationProperties.Name="{Binding Name}" />
                                            <Path DockPanel.Dock="Left" Style="{StaticResource Panel.RowIcon}"
                                                  Margin="0,0,11,0" Data="{StaticResource Panel.CalendarIcon}" />
                                            <TextBlock x:Name="PolicyLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Summary}">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text=" " />
                                                <Run Text="{Binding Summary, Mode=OneWay}"
                                                     Foreground="{DynamicResource Brush.Text.Secondary}" />
                                            </TextBlock>
                                        </DockPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter TargetName="PolicyLabel" Property="Foreground"
                                                        Value="{DynamicResource Brush.Text.Muted}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <DockPanel x:Name="RuntimeScheduleEmpty" MinHeight="24" LastChildFill="False">
                             <Path Style="{StaticResource Panel.RowIcon}" Margin="0,0,11,0"
                                   Data="{StaticResource Panel.CalendarIcon}" />
                            <TextBlock Text="暂无定时" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="ActivitySection" Grid.Row="3" Style="{StaticResource Panel.Section}"
                    KeyboardNavigation.TabNavigation="Local">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Style="{StaticResource Panel.SectionHeader}">
                        <Button x:Name="ClearActivityButton" DockPanel.Dock="Right" Width="26"
                                Style="{StaticResource Panel.QuietButton}"
                                ToolTip="清空运行动态" AutomationProperties.Name="清空运行动态">
                            <Button.Visibility>
                                <Binding Path="HasItems" ElementName="HomeLogListBox"
                                         Converter="{StaticResource Panel.BooleanToVisibility}" />
                            </Button.Visibility>
                            <Path Style="{StaticResource Panel.OutlineIcon}"
                                  Data="M3,4.5 H13 M6.5,4.5 V3 H9.5 V4.5 M4.5,4.5 L5.1,13 H10.9 L11.5,4.5" />
                        </Button>
                        <Button x:Name="ActivitySectionToggle" Content="运行动态" Style="{StaticResource Panel.SectionToggle}" />
                    </DockPanel>
                    <Grid x:Name="ActivitySectionBody" Grid.Row="1" Margin="16,0,12,9">
                        <ListBox x:Name="HomeLogListBox" ItemsSource="{Binding LogLines}"
                                 Style="{StaticResource LogListBoxStyle}" Background="{DynamicResource Brush.Transparent}"
                                 BorderThickness="0" Padding="0" FontFamily="{StaticResource FontFamily.Ui}"
                                 VirtualizingPanel.ScrollUnit="Item" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="运行动态"
                                 AutomationProperties.HelpText="最新在顶部，按任务分组，仅显示用户运行日志">
                            <ListBox.Resources>
                                <DataTemplate DataType="{x:Type models:RunLogGroup}">
                                    <DockPanel Margin="0,9,0,3" LastChildFill="False">
                                        <TextBlock Text="{Binding Label}" MaxWidth="180" FontWeight="Medium" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock x:Name="GroupStatus" Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="14"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RunLogStatus.Running}">
                                            <Setter TargetName="GroupStatus" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RunLogStatus.Succeeded}">
                                            <Setter TargetName="GroupStatus" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:RunLogStatus.Failed}">
                                            <Setter TargetName="GroupStatus" Property="Foreground"
                                                    Value="{DynamicResource Brush.Error.Foreground}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type models:LogEntry}">
                                    <DockPanel MinHeight="22">
                                        <TextBlock DockPanel.Dock="Left" Width="72" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                   FontFamily="{StaticResource FontFamily.Monospace}" FontSize="13"
                                                   Padding="0,2,0,0" Foreground="{DynamicResource Brush.Activity.Caption}" />
                                        <TextBlock Text="{Binding Message}" FontFamily="{StaticResource FontFamily.Monospace}"
                                                   FontSize="13" Padding="0,2,0,2" TextWrapping="Wrap"
                                                   AutomationProperties.HelpText="{Binding DisplayLevel}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.Resources>
                        </ListBox>
                        <DockPanel MinHeight="24" VerticalAlignment="Top" LastChildFill="False" IsHitTestVisible="False">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=HomeLogListBox}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <Path Style="{StaticResource Panel.RowIcon}" Margin="0,0,11,0">
                                <Path.Data>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="3,2.25,10,11.5" RadiusX="1.5" RadiusY="1.5" />
                                        <PathGeometry Figures="M5.5,5.5 H10.5 M5.5,8 H10.5 M5.5,10.5 H8.5" />
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>
                            <TextBlock Text="暂无运行动态" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

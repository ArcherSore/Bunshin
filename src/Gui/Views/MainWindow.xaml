<ui:FluentWindow x:Class="Gui.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Gui.Views"
                 xmlns:protocol="clr-namespace:Protocol;assembly=Protocol"
                 Title="{x:Static protocol:AppIdentity.Name}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{DynamicResource Brush.Canvas}"
                 Foreground="{DynamicResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="Preview.IconFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Preview.IconButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Disabled}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RuntimePanel.Edge" TargetType="Thumb">
            <Setter Property="Margin" Value="0,0,-4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rail.Border}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=RuntimeSidebar}" Value="Collapsed">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="Update.ButtonLabel">
            <TextBlock Text="{Binding}" FontWeight="SemiBold"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <ControlTemplate x:Key="Welcome.ButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Section}"
                    SnapsToDevicePixels="True">
                <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
        </ControlTemplate>
        <Style x:Key="Welcome.CloseButton" TargetType="Button" BasedOn="{StaticResource Preview.IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template" Value="{StaticResource Welcome.ButtonTemplate}" />
        </Style>
        <DataTemplate x:Key="Welcome.DismissLabel">
            <TextBlock Text="{Binding}" FontSize="{StaticResource FontSize.SectionTitle}" FontWeight="Medium"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <Style x:Key="Welcome.DismissButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="ContentTemplate" Value="{StaticResource Welcome.DismissLabel}" />
            <Setter Property="Template" Value="{StaticResource Welcome.ButtonTemplate}" />
        </Style>
        <Style x:Key="Update.PrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="ContentTemplate" Value="{StaticResource Update.ButtonLabel}" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="WindowOverlayRoot">
    <Grid x:Name="MainWindowContent">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=UpdateOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Visibility, ElementName=WelcomeOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Performance" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Shell: the sidebar on the left; header and the page host (ShellContent) on the right. -->
        <views:ShellSidebar x:Name="Sidebar" Grid.Column="0" HorizontalAlignment="Left" Panel.ZIndex="2" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <views:ShellHeader x:Name="Header" Grid.Row="0">
                <views:ShellHeader.Actions>
                    <Button Width="28" Height="28" MinHeight="28" Padding="0"
                            Style="{StaticResource Preview.IconButton}" Click="RuntimePanelToggleButton_Click">
                        <ui:SymbolIcon Symbol="PanelRight24" FontSize="16" />
                    </Button>
                </views:ShellHeader.Actions>
            </views:ShellHeader>

            <Grid x:Name="ShellContent" Grid.Row="1">
                <Grid Background="{DynamicResource Brush.Canvas}">
                    <!-- Settings owns its definition-driven view and namescope. -->
                    <Grid x:Name="HomeView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420" />
                            <ColumnDefinition x:Name="RuntimeSidebarColumn" Width="392" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <views:TaskPlanEditor x:Name="TaskPlanEditor" />
                        </Grid>
                        <Thumb x:Name="RuntimeSidebarSplitter" Grid.Column="0" Width="8" Panel.ZIndex="1"
                               HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE"
                               Focusable="True" Style="{StaticResource RuntimePanel.Edge}"
                               DragStarted="RuntimeSidebarSplitter_DragStarted" DragDelta="RuntimeSidebarSplitter_DragDelta"
                               DragCompleted="RuntimeSidebarSplitter_DragCompleted" KeyDown="RuntimeSidebarSplitter_KeyDown"
                               LostKeyboardFocus="RuntimeSidebarSplitter_LostKeyboardFocus"
                               AutomationProperties.Name="调整运行面板宽度"
                               AutomationProperties.HelpText="拖动或使用左右方向键调整宽度" />
                        <views:RuntimePanel x:Name="RuntimeSidebar" Grid.Column="1" />
                    </Grid>

                    <views:ScheduleView x:Name="ScheduleView" Visibility="Collapsed" />
                    <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" />
                    <views:HelpView x:Name="HelpView" Visibility="Collapsed" />
                    <Border x:Name="SidebarDismissLayer" Background="{DynamicResource Brush.Overlay.Dim}"
                            Panel.ZIndex="1" Visibility="Collapsed"
                            MouseLeftButtonDown="SidebarDismissLayer_MouseLeftButtonDown" />

                    <Grid x:Name="TaskDescriptionOverlay"
                          Panel.ZIndex="100"
                          Visibility="Collapsed"
                          AutomationProperties.Name="任务描述">
                        <Button Background="{DynamicResource Brush.Overlay.Dim}"
                                BorderThickness="0"
                                Focusable="False"
                                Click="TaskDescriptionScrim_Click" />
                        <Border Width="420"
                                MaxWidth="420"
                                HorizontalAlignment="Right"
                                Style="{StaticResource TaskDescriptionDrawerStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TaskDescriptionDrawerTitle"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource StatusPrimaryTextStyle}" />
                                    <Button x:Name="TaskDescriptionCloseButton"
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource CompactIconButtonStyle}"
                                            AutomationProperties.Name="关闭任务描述"
                                            Click="TaskDescriptionCloseButton_Click">
                                        <ui:SymbolIcon Width="16" Height="16" Symbol="Dismiss16" />
                                    </Button>
                                </Grid>
                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="0,14,0,14"
                                        Background="{DynamicResource Brush.Border}" />
                                <FlowDocumentScrollViewer x:Name="TaskDescriptionViewer" Grid.Row="2"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          IsToolBarVisible="False" Zoom="100" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
        <Grid x:Name="UpdateOverlay" Panel.ZIndex="210" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              SizeChanged="UpdateOverlay_SizeChanged"
              AutomationProperties.Name="软件更新">
            <Button Background="{DynamicResource Brush.Overlay.Update}" BorderThickness="0" Focusable="False"
                    IsTabStop="False"
                    Click="CloseUpdate_Click" AutomationProperties.Name="关闭软件更新遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <views:SoftwareUpdateDialog x:Name="UpdateDialog" Width="400" MaxHeight="600" Margin="24"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="WelcomeOverlay" Panel.ZIndex="210" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              SizeChanged="WelcomeOverlay_SizeChanged" AutomationProperties.Name="欢迎信息">
            <Button x:Name="WelcomeScrim" Background="{DynamicResource Brush.Overlay.Modal}" BorderThickness="0"
                    Focusable="False" IsTabStop="False" Click="CloseWelcome_Click"
                    AutomationProperties.Name="关闭欢迎信息遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Grid x:Name="WelcomeDialog" Width="512" HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="WelcomeDialogScale" />
                </Grid.RenderTransform>
                <!-- The shadow is drawn behind the opaque background without a full-dialog effect texture. -->
                <views:ShadowBorder Background="{DynamicResource Brush.Surface}" CornerRadius="16"
                                    Shadow="{DynamicResource Effect.Dialog.Welcome}" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="24,16" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="WelcomeCloseButton" DockPanel.Dock="Right" Click="CloseWelcome_Click"
                                    Style="{StaticResource Welcome.CloseButton}" ToolTip="关闭（Esc）"
                                    AutomationProperties.Name="关闭欢迎信息">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="20" />
                            </Button>
                            <ui:SymbolIcon x:Name="WelcomeIcon" Symbol="Sparkle24" FontSize="20" Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Primary}" />
                            <TextBlock x:Name="WelcomeTitle" FontSize="18" FontWeight="SemiBold" LineHeight="28"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                        </DockPanel>
                    </Border>
                    <FlowDocumentScrollViewer x:Name="WelcomeViewer" Grid.Row="1" Margin="24,16,12,16" Zoom="100"
                                              VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                              HorizontalScrollBarVisibility="Disabled" />
                    <Border Grid.Row="2" Padding="24,16" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <Button x:Name="WelcomeDismissButton" Content="我知道了" Click="CloseWelcome_Click"
                                Style="{StaticResource Welcome.DismissButton}" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="OnboardingOverlay" Panel.ZIndex="220" Visibility="Collapsed"
              Background="{DynamicResource Brush.Transparent}"
              Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" AllowDrop="True"
              PreviewDrop="Onboarding_BlockDrop" PreviewDragOver="Onboarding_BlockDrop"
              AutomationProperties.Name="新手指引">
            <Grid.Resources>
                <DataTemplate x:Key="Onboarding.ActionText">
                    <TextBlock Text="{Binding}"
                               FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"
                               FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </DataTemplate>
            </Grid.Resources>
            <Path x:Name="OnboardingDim" Fill="{DynamicResource Brush.Overlay.Onboarding}" IsHitTestVisible="False" />
            <Path x:Name="OnboardingOutline" Stroke="{DynamicResource Brush.Primary.Border}" StrokeThickness="1"
                  IsHitTestVisible="False" />
            <Canvas IsHitTestVisible="False">
                <Border x:Name="OnboardingPulse" Visibility="Collapsed" CornerRadius="12" Width="24" Height="24"
                        BorderBrush="{DynamicResource Brush.Primary}" BorderThickness="1.25"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                </Border>
                <Path x:Name="OnboardingArrow" Fill="{DynamicResource Brush.Surface}" />
            </Canvas>
            <views:ShadowBorder x:Name="OnboardingPopover" Width="312"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Padding="18" Background="{DynamicResource Brush.Surface}"
                    CornerRadius="{StaticResource Radius.Section}" Shadow="{DynamicResource Effect.Surface.Light}"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="True" Margin="0,0,0,12">
                        <TextBlock x:Name="OnboardingCounter" DockPanel.Dock="Right" Margin="10,2,0,0"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock x:Name="OnboardingTitle" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <TextBlock x:Name="OnboardingDescription" TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="OnboardingSkip" Content="跳过" HorizontalAlignment="Left"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Padding="12,0" Height="34" FontSize="13" FontWeight="Normal"
                                Foreground="{DynamicResource Brush.Text.Secondary}"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnboardingSkip_Click" AutomationProperties.Name="跳过新手指引" />
                        <Button x:Name="OnboardingPrevious" Grid.Column="1" Content="上一步" Margin="4,0,8,0"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Padding="14,0" Height="34" FontSize="13" FontWeight="Normal"
                                Style="{StaticResource SubtleButtonStyle}"
                                Click="OnboardingPrevious_Click" AutomationProperties.Name="上一步" />
                        <Button x:Name="OnboardingNext" Grid.Column="2" Content="下一步" Padding="14,0"
                                Width="88" Height="34" FontSize="13" FontWeight="SemiBold"
                                ContentTemplate="{StaticResource Onboarding.ActionText}"
                                Style="{StaticResource PrimaryButtonStyle}" Click="OnboardingNext_Click"
                                AutomationProperties.Name="下一步" />
                    </Grid>
                </Grid>
            </views:ShadowBorder>
        </Grid>

        <Grid x:Name="ForcedStartOverlay" Panel.ZIndex="230" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              Background="{DynamicResource Brush.Overlay.Modal}" AutomationProperties.Name="强制定时启动">
            <views:ShadowBorder Width="400" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Dialog.Border}" BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Section}" Shadow="{DynamicResource Effect.Dialog}">
                <StackPanel>
                    <TextBlock Text="强制定时启动" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock x:Name="ForcedStartText" Margin="0,8,0,14" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <Grid Height="4" Background="{DynamicResource Brush.Progress.Track}">
                        <Border Background="{DynamicResource Brush.Warning}">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ForcedStartFillScale" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="取消后，当前任务继续运行" VerticalAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}" />
                        <Button x:Name="ForcedStartCancelButton" Grid.Column="1" Content="取消" MinWidth="88"
                                Height="36" Style="{StaticResource Update.PrimaryButton}"
                                Click="ForcedStartCancel_Click" AutomationProperties.Name="取消强制定时启动" />
                    </Grid>
                </StackPanel>
            </views:ShadowBorder>
        </Grid>
    </Grid>
</ui:FluentWindow>

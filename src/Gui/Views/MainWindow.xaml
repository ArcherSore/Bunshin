<ui:FluentWindow x:Class="Gui.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Gui.Views"
                 xmlns:protocol="clr-namespace:Protocol;assembly=Protocol"
                 Title="{x:Static protocol:AppIdentity.Name}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="1180"
                 Height="760"
                 MinWidth="920"
                 MinHeight="640"
                 Background="{DynamicResource Brush.Canvas}"
                 Foreground="{DynamicResource Brush.Text.Body}"
                 FontFamily="{StaticResource FontFamily.Ui}"
                 FontSize="{StaticResource FontSize.Body}"
                 ExtendsContentIntoTitleBar="True"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <Style x:Key="Preview.IconFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RuntimePanel.Toggle" TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="2,2.5,12,11" RadiusX="2" RadiusY="2" />
                                            <PathGeometry Figures="M10,2.5 V13.5" />
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Hover}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Rail.Active}" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RuntimePanel.Edge" TargetType="Thumb">
            <Setter Property="Margin" Value="0,0,-4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Rail.Border}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Preview.IconFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Background="{TemplateBinding BorderBrush}" IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Visibility, ElementName=RuntimeSidebar}" Value="Collapsed">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid x:Name="WindowOverlayRoot">
    <Grid x:Name="MainWindowContent">
        <Grid.Style>
            <Style TargetType="{x:Type Grid}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=SettingsOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Visibility, ElementName=UpdateOverlay}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Visibility, ElementName=ProjectReader}" Value="Visible">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Shell: the sidebar on the left; header and the page host (ShellContent) on the right. -->
        <views:ShellSidebar x:Name="Sidebar" Grid.Column="0" HorizontalAlignment="Left" Panel.ZIndex="2" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <views:ShellHeader x:Name="Header" Grid.Row="0">
                <views:ShellHeader.Actions>
                    <Button Style="{StaticResource RuntimePanel.Toggle}" Click="RuntimePanelToggleButton_Click" />
                </views:ShellHeader.Actions>
            </views:ShellHeader>

            <Grid x:Name="ShellContent" Grid.Row="1">
                <Grid Background="{DynamicResource Brush.Canvas}">
                    <Grid x:Name="HomeView">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="420" />
                            <ColumnDefinition x:Name="RuntimeSidebarColumn" Width="392" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <views:TaskPlanEditor x:Name="TaskPlanEditor" />
                        </Grid>
                        <Thumb x:Name="RuntimeSidebarSplitter" Grid.Column="0" Width="8" Panel.ZIndex="1"
                               HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="SizeWE"
                               Focusable="True" Style="{StaticResource RuntimePanel.Edge}"
                               DragStarted="RuntimeSidebarSplitter_DragStarted" DragDelta="RuntimeSidebarSplitter_DragDelta"
                               DragCompleted="RuntimeSidebarSplitter_DragCompleted" KeyDown="RuntimeSidebarSplitter_KeyDown"
                               LostKeyboardFocus="RuntimeSidebarSplitter_LostKeyboardFocus"
                               AutomationProperties.Name="调整运行面板宽度"
                               AutomationProperties.HelpText="拖动或使用左右方向键调整宽度" />
                        <views:RuntimePanel x:Name="RuntimeSidebar" Grid.Column="1" />
                    </Grid>

                    <views:ScheduleView x:Name="ScheduleView" Visibility="Collapsed" />
                    <views:HelpView x:Name="HelpView" Visibility="Collapsed" />
                    <Border x:Name="SidebarDismissLayer" Background="{DynamicResource Brush.Overlay.Dim}"
                            Panel.ZIndex="1" Visibility="Collapsed"
                            MouseLeftButtonDown="SidebarDismissLayer_MouseLeftButtonDown" />
                </Grid>
            </Grid>
        </Grid>

    </Grid>
        <Grid x:Name="SettingsOverlay" Panel.ZIndex="200" Visibility="Collapsed"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              AutomationProperties.Name="设置">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, ElementName=UpdateOverlay}" Value="Visible">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ProjectReader}" Value="Visible">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=ForcedStartOverlay}" Value="Visible">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Visibility, ElementName=PromptOverlay}" Value="Visible">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="{DynamicResource Brush.Overlay.Dim}" MouseLeftButtonDown="SettingsScrim_MouseLeftButtonDown" />
            <views:SettingsView x:Name="SettingsView" MaxWidth="960" MaxHeight="740" Margin="32,42" />
        </Grid>
        <Grid x:Name="UpdateOverlay" Panel.ZIndex="210" Visibility="Collapsed" Focusable="True"
              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
              SizeChanged="UpdateOverlay_SizeChanged"
              AutomationProperties.Name="软件更新">
            <Button Background="{DynamicResource Brush.Overlay.Update}" BorderThickness="0" Focusable="False"
                    IsTabStop="False"
                    Click="CloseUpdate_Click" AutomationProperties.Name="关闭软件更新遮罩">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <views:SoftwareUpdateDialog x:Name="UpdateDialog" Width="400" MaxHeight="600" Margin="24"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <views:ProjectReaderView x:Name="ProjectReader" Panel.ZIndex="210" Visibility="Collapsed"
                                 DismissRequested="CloseProjectReader_Requested" />

        <views:OnboardingView x:Name="OnboardingOverlay" Panel.ZIndex="220" Visibility="Collapsed" />

        <Grid x:Name="ForcedStartOverlay" Panel.ZIndex="230" Visibility="Collapsed"
              Background="{DynamicResource Brush.Overlay.Modal}" AutomationProperties.Name="强制定时启动">
            <views:WindowDialog x:Name="ForcedStartDialog" Width="400" MaxHeight="560" Margin="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="PromptOverlay" Panel.ZIndex="240" Visibility="Collapsed"
              Background="{DynamicResource Brush.Overlay.Modal}">
            <views:WindowDialog x:Name="PromptDialog" Width="420" MaxHeight="560" Margin="24"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</ui:FluentWindow>

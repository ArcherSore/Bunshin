<UserControl x:Class="Gui.Views.ListReorderFeedback"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False" ClipToBounds="True" Visibility="Collapsed">
    <Canvas>
        <Grid x:Name="InsertionMarker" Height="8">
            <Border Height="2" Margin="6,0,0,0" Background="{DynamicResource Brush.Primary}" />
            <Ellipse Width="8" Height="8" HorizontalAlignment="Left" StrokeThickness="2"
                     Stroke="{DynamicResource Brush.Primary}" Fill="{DynamicResource Brush.Surface.Subdued}" />
        </Grid>
        <Border x:Name="FloatingRow" Height="32" CornerRadius="8" Padding="8,0"
                Background="{DynamicResource Brush.Surface}" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Border}" Effect="{DynamicResource Effect.Surface.Drag}">
            <Border.RenderTransform>
                <RotateTransform Angle="-1" />
            </Border.RenderTransform>
            <TextBlock x:Name="FloatingLabel" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
        </Border>
    </Canvas>
</UserControl>

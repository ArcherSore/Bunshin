<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style x:Key="Inspector.Label" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Inspector.Note" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Inspector.DraftNote" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style x:Key="Inspector.Error" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
    </Style>
    <Style x:Key="Inspector.Shared" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
    </Style>
    <Style x:Key="Inspector.InputLabel" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Label}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Option.TextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClearButtonEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ui:PassiveScrollViewer x:Name="PART_ContentHost"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                Style="{DynamicResource DefaultTextBoxScrollViewerStyle}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.FieldHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.PasswordBox" TargetType="ui:PasswordBox" BasedOn="{StaticResource Option.TextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                            Padding="10,0,4,0">
                        <DockPanel>
                            <Button x:Name="RevealPassword" DockPanel.Dock="Right" Width="24" Height="24"
                                    MinWidth="0" MinHeight="0" Padding="0"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTip="显示密码" AutomationProperties.Name="显示密码"
                                    Command="{Binding TemplateButtonCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    CommandParameter="reveal">
                                <ui:SymbolIcon x:Name="RevealIcon" Symbol="Eye24" FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                            </Button>
                            <ui:PassiveScrollViewer x:Name="PART_ContentHost"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Style="{DynamicResource DefaultTextBoxScrollViewerStyle}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPasswordRevealed" Value="True">
                            <Setter TargetName="RevealIcon" Property="Symbol" Value="EyeOff24" />
                            <Setter TargetName="RevealPassword" Property="ToolTip" Value="隐藏密码" />
                            <Setter TargetName="RevealPassword" Property="AutomationProperties.Name" Value="隐藏密码" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Option.CaseItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding Description}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <DockPanel VerticalAlignment="Center">
                            <ui:SymbolIcon x:Name="Check" Symbol="Checkmark12" FontSize="12"
                                           Margin="0,0,4,0" Visibility="Collapsed"
                                           Foreground="{DynamicResource Brush.Primary}" />
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       Foreground="{TemplateBinding Foreground}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.FieldHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.SegmentItem" TargetType="ListBoxItem" BasedOn="{StaticResource Option.CaseItem}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Option.Choices" TargetType="ListBox">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.Chips" TargetType="ListBox" BasedOn="{StaticResource Option.Choices}">
        <Setter Property="SelectionMode" Value="Multiple" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Option.CaseItem}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0,0,0,1" />
    </Style>
    <Style x:Key="Option.Segments" TargetType="ListBox" BasedOn="{StaticResource Option.Choices}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Option.SegmentItem}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Field}" />
        <Setter Property="Padding" Value="1,2" />
    </Style>

    <Style x:Key="Option.ToggleSwitch" TargetType="ui:ToggleSwitch">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ToggleSwitch">
                    <Border Background="{DynamicResource Brush.Transparent}">
                        <DockPanel VerticalAlignment="Center">
                            <Border x:Name="Track" Width="32" Height="18" CornerRadius="9"
                                    Background="{DynamicResource Brush.Parameter.SwitchOff}" Margin="0,0,10,0">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="2"
                                         HorizontalAlignment="Left" Fill="{DynamicResource Brush.Text.Inverse}" />
                            </Border>
                            <TextBlock x:Name="Caption" Text="{Binding OffContent, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter TargetName="Caption" Property="Text" Value="{Binding OnContent,
                                    RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Option.DropdownLabel">
        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.Text.Primary}"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="Option.ComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="ItemTemplate" Value="{StaticResource Option.DropdownLabel}" />
        <Setter Property="TextSearch.TextPath" Value="Label" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Margin" Value="0,0,0,1" />
                    <Setter Property="ToolTip" Value="{Binding Description}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Item" CornerRadius="8" Padding="10,0"
                                        Background="{DynamicResource Brush.Transparent}">
                                    <DockPanel VerticalAlignment="Center">
                                        <ui:SymbolIcon x:Name="Check" DockPanel.Dock="Right" Symbol="Checkmark12"
                                                       FontSize="12" Margin="6,0,0,0" Visibility="Collapsed"
                                                       Foreground="{DynamicResource Brush.Primary}" />
                                        <ContentPresenter />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Plan.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Description}" Value="">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Field" CornerRadius="8" Padding="12,0,8,0"
                                            Background="{DynamicResource Brush.Parameter.Field}">
                                        <ui:SymbolIcon Symbol="ChevronDown12" FontSize="12"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource Brush.Parameter.FieldHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource Brush.Parameter.SwitchOff}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="12,0,28,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{StaticResource Option.DropdownLabel}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Placement="Bottom" VerticalOffset="2">
                            <Border CornerRadius="12" Padding="6" MinWidth="200"
                                    BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    Background="{DynamicResource Brush.Surface.Popover}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

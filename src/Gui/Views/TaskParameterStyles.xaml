<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:views="clr-namespace:Gui.Views">

    <Style x:Key="Inspector.Label" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Inspector.Note" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Inspector.DraftNote" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style x:Key="Inspector.Error" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Note}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
    </Style>
    <Style x:Key="Inspector.InputLabel" TargetType="TextBlock" BasedOn="{StaticResource Inspector.Label}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Option.TextBox" TargetType="ui:TextBox">
        <Setter Property="ContextMenu" Value="{DynamicResource DefaultControlContextMenu}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClearButtonEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:TextBox">
                    <Grid>
                        <Border x:Name="FocusHalo" Style="{StaticResource FieldFocusHaloStyle}" />
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ui:PassiveScrollViewer x:Name="PART_ContentHost"
                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    Style="{DynamicResource DefaultTextBoxScrollViewerStyle}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusHalo" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.FieldHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.PasswordBox" TargetType="ui:PasswordBox" BasedOn="{StaticResource Option.TextBox}">
        <Setter Property="ContextMenu" Value="{DynamicResource DefaultPasswordBoxContextMenu}" />
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsKeyboardFocusWithin" Value="False" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.PasswordHover}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.CaseItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,4" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="{Binding Description}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding Label}" FontSize="14" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Description}" Value="">
                <Setter Property="ToolTip" Value="{x:Null}" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.FieldHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Selected}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.SegmentItem" TargetType="ListBoxItem" BasedOn="{StaticResource Option.CaseItem}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Option.Choices" TargetType="ListBox">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Transparent}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Option.Chips" TargetType="ListBox" BasedOn="{StaticResource Option.Choices}">
        <Setter Property="SelectionMode" Value="Multiple" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Option.CaseItem}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0,0,0,1" />
    </Style>
    <Style x:Key="Option.Segments" TargetType="ListBox" BasedOn="{StaticResource Option.Choices}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Option.SegmentItem}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.Field}" />
        <Setter Property="Padding" Value="1,2" />
    </Style>

    <Style x:Key="Option.ToggleSwitch" TargetType="ui:ToggleSwitch">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Height" Value="{StaticResource Height.OptionEditor}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource Brush.Parameter.SwitchOff}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ToggleSwitch">
                    <Border Background="{DynamicResource Brush.Transparent}">
                        <DockPanel VerticalAlignment="Center">
                            <Border Style="{StaticResource SwitchTrackStyle}" Width="32" Height="18" Margin="0,0,10,0">
                                <Ellipse x:Name="Knob" Style="{StaticResource SwitchKnobStyle}" />
                            </Border>
                            <TextBlock x:Name="Caption" FontSize="14" Text="{Binding OffContent, RelativeSource={RelativeSource TemplatedParent}}"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Muted}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Caption" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            <Setter TargetName="Caption" Property="Text" Value="{Binding OnContent,
                                    RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{StaticResource Opacity.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="Option.DropdownLabel">
        <TextBlock Text="{Binding Label}" FontSize="14" Foreground="{DynamicResource Brush.Text.Primary}"
                   TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <Style x:Key="Option.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource ChoiceBoxStyle}">
        <Setter Property="ItemTemplate" Value="{StaticResource Option.DropdownLabel}" />
        <Setter Property="TextSearch.TextPath" Value="Label" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ChoiceItemStyle}">
                    <Setter Property="ToolTip" Value="{Binding Description}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Description}" Value="">
                            <Setter Property="ToolTip" Value="{x:Null}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- Primitive colors, private to this palette. -->
    <Color x:Key="Color.Amber.50">#FFF4E5</Color>
    <Color x:Key="Color.Amber.100">#FDE8C8</Color>
    <Color x:Key="Color.Amber.700">#8A5400</Color>
    <Color x:Key="Color.Amber.800">#7A4700</Color>
    <Color x:Key="Color.Black.Alpha26">#1A000000</Color>
    <Color x:Key="Color.Black.Alpha32">#20000000</Color>
    <Color x:Key="Color.Black.Alpha38">#26000000</Color>
    <Color x:Key="Color.Black.Alpha128">#80000000</Color>
    <Color x:Key="Color.Green.50">#E7F5EC</Color>
    <Color x:Key="Color.Green.200">#A9D7BF</Color>
    <Color x:Key="Color.Green.600">#26734D</Color>
    <Color x:Key="Color.Green.700">#1E5C3E</Color>
    <Color x:Key="Color.Green.800">#174830</Color>
    <Color x:Key="Color.Indigo.50">#EDF3FF</Color>
    <Color x:Key="Color.Indigo.75">#E6EDFA</Color>
    <Color x:Key="Color.Indigo.700">#284A91</Color>
    <Color x:Key="Color.Indigo.800">#203F7E</Color>
    <Color x:Key="Color.Neutral.10">#FBFCFE</Color>
    <Color x:Key="Color.Neutral.25">#F8FAFD</Color>
    <Color x:Key="Color.Neutral.50">#F6F8FB</Color>
    <Color x:Key="Color.Neutral.50.Clear">#00F6F8FB</Color>
    <Color x:Key="Color.Neutral.100">#EEF2F6</Color>
    <Color x:Key="Color.Neutral.150">#E4EAF0</Color>
    <Color x:Key="Color.Neutral.160">#E3E8EF</Color>
    <Color x:Key="Color.Neutral.175">#DCE3EC</Color>
    <Color x:Key="Color.Neutral.200">#D6DEE8</Color>
    <Color x:Key="Color.Neutral.400">#7B899B</Color>
    <Color x:Key="Color.Neutral.450">#718096</Color>
    <Color x:Key="Color.Neutral.500">#5F6E80</Color>
    <Color x:Key="Color.Neutral.600">#465467</Color>
    <Color x:Key="Color.Neutral.800">#26313F</Color>
    <Color x:Key="Color.Neutral.900">#182230</Color>
    <Color x:Key="Color.Neutral.900.Alpha13">#0D182230</Color>
    <Color x:Key="Color.Red.50">#FDEBED</Color>
    <Color x:Key="Color.Red.200">#E7AAB0</Color>
    <Color x:Key="Color.Red.600">#B4232F</Color>
    <Color x:Key="Color.Red.700">#9E1C2A</Color>

    <!-- Color-valued tokens for gradient stops and animation targets. -->
    <Color x:Key="Color.Primary">#3156A3</Color>
    <Color x:Key="Color.Primary.Border">#B8CCF4</Color>
    <Color x:Key="Color.Primary.SurfaceHover">#DCE8FC</Color>
    <Color x:Key="Color.Splitter.Shadow">#182230</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>

    <!-- Stable brushes are frozen to avoid Freezable change tracking. -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Neutral.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Subdued" Color="{StaticResource Color.Neutral.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Option" Color="{StaticResource Color.Neutral.25}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface.Disabled" Color="{StaticResource Color.Neutral.100}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Neutral.200}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Neutral.150}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Neutral.400}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Overlay.Dim" Color="{StaticResource Color.Black.Alpha32}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Overlay.Modal" Color="{StaticResource Color.Black.Alpha128}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Neutral.900}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Body" Color="{StaticResource Color.Neutral.800}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Neutral.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Neutral.500}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Neutral.450}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Surface}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Hover" Color="{StaticResource Color.Indigo.700}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Pressed" Color="{StaticResource Color.Indigo.800}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Surface" Color="{StaticResource Color.Indigo.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.SurfaceHover" Color="{StaticResource Color.Primary.SurfaceHover}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Primary.Border" Color="{StaticResource Color.Primary.Border}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Green.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tasks.Accent" Color="{StaticResource Color.Green.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tasks.Accent.Surface"
                     Color="{StaticResource Color.Green.50}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tasks.Accent.Border"
                     Color="{StaticResource Color.Green.200}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tasks.Accent.Hover" Color="{StaticResource Color.Green.700}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Tasks.Accent.Pressed" Color="{StaticResource Color.Green.800}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Amber.700}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.Foreground"
                     Color="{StaticResource Color.Amber.800}"
                     po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Red.600}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Surface" Color="{StaticResource Color.Red.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Border" Color="{StaticResource Color.Red.200}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Error.Foreground" Color="{StaticResource Color.Red.700}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" po:Freeze="True" />
    <!-- Parameter inspector: nested rows sit on a faint tint beside a guide line. -->
    <SolidColorBrush x:Key="Brush.Parameter.Nested" Color="{StaticResource Color.Neutral.10}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Parameter.Guide" Color="{StaticResource Color.Neutral.175}" po:Freeze="True" />
    <!-- Navigation rail and runtime console surfaces. -->
    <SolidColorBrush x:Key="Brush.Rail.Border" Color="{StaticResource Color.Neutral.160}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Rail.Hover" Color="{StaticResource Color.Neutral.900.Alpha13}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Rail.Active" Color="{StaticResource Color.Indigo.75}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="{StaticResource Color.Neutral.160}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.Surface" Color="{StaticResource Color.Amber.50}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning.SurfaceHover" Color="{StaticResource Color.Amber.100}" po:Freeze="True" />
    <!-- Title bar buttons beside WPF-UI's caption buttons share their hover overlay. -->
    <SolidColorBrush x:Key="Brush.TitleBar.Hover" Color="{StaticResource Color.Black.Alpha26}" po:Freeze="True" />
    <SolidColorBrush x:Key="Brush.TitleBar.Pressed" Color="{StaticResource Color.Black.Alpha38}" po:Freeze="True" />

    <LinearGradientBrush x:Key="Brush.Scroll.FadeTop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Color.Neutral.50}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Neutral.50.Clear}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Scroll.FadeBottom" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Color.Neutral.50.Clear}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Neutral.50}" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Effect.Surface.Light"
                      BlurRadius="8"
                      Direction="270"
                      Opacity="0.08"
                      ShadowDepth="1" />
    <DropShadowEffect x:Key="Effect.Surface.Drag"
                      BlurRadius="12"
                      Direction="270"
                      Opacity="0.14"
                      ShadowDepth="2" />
    <DropShadowEffect x:Key="Effect.Surface.Drawer"
                      BlurRadius="16"
                      Direction="180"
                      Opacity="0.10"
                      ShadowDepth="3" />
</ResourceDictionary>

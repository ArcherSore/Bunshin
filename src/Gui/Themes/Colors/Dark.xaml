        <GradientStop Offset="0" Color="#134A91" />
        <GradientStop Offset="1" Color="#1F68B8" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Configuration.FadeLeft" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#262626" />
        <GradientStop Offset="1" Color="#00262626" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Configuration.FadeRight" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Offset="0" Color="#00262626" />
        <GradientStop Offset="1" Color="#262626" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Scroll.FadeTop" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#191919" />
        <GradientStop Offset="1" Color="#00191919" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Scroll.FadeBottom" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#00191919" />
        <GradientStop Offset="1" Color="#191919" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Splitter.Tether" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.5" Color="#33FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Splitter.Tether.Dragging" StartPoint="0,0" EndPoint="0,1" po:Freeze="True">
        <GradientStop Offset="0" Color="#00257DE0" />
        <GradientStop Offset="0.5" Color="#257DE0" />
        <GradientStop Offset="1" Color="#00257DE0" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="Effect.Configuration.SelectedTab" Color="#000000" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Console.Card" Color="#000000" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.3" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Dialog" Color="#000000" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.4" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Dialog.Welcome" Color="#000000" BlurRadius="50" ShadowDepth="25" Direction="270" Opacity="0.5" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Surface.Light" Color="#000000" BlurRadius="8" ShadowDepth="1" Direction="270" Opacity="0.3" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Surface.Drag" Color="#000000" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" po:Freeze="True" />
    <DropShadowEffect x:Key="Effect.Surface.Drawer" Color="#000000" BlurRadius="16" ShadowDepth="3" Direction="180" Opacity="0.35" po:Freeze="True" />
